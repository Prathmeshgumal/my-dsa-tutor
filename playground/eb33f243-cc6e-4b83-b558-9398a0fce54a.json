{"id":"eb33f243-cc6e-4b83-b558-9398a0fce54a","title":"Dry run: row-wise and column-wise sum of a 3×3 matrix","file":"prt_row_wise_sum.cpp","language":"cpp","code":"#include<iostream>\nusing namespace std;\n\nvoid prtRowSum(int arr[][3], int colsize, int rowsize){\n    for(int i=0;i<rowsize;i++){\n        int sum = 0;\n        for(int j=0;j<colsize;j++){\n            sum = sum+arr[i][j];\n        }\n        cout<<\"Row sum for row \"<<i<<\" is \"<< sum<<endl;\n\n    }\n}\nvoid prtColSum(int arr[][3], int colsize, int rowsize){\n    for(int i=0;i<colsize;i++){\n        int sum = 0;\n        for(int j=0;j<rowsize;j++){\n            sum = sum+arr[j][i];\n        }\n        cout<<\"Col sum for row \"<<i<<\" is \"<< sum<<endl;\n\n    }\n}\n\n\n\nint main(){\n    int arr[3][3] = {\n        {1,2,3},\n        {4,5,6},\n        {7,8,9}\n    };\n    prtRowSum(arr,3,3);\n    cout<<endl;\n    prtColSum(arr,3,3);\n}","problem":"spiral-matrix","input":"arr = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792607609135,"steps":[{"line":27,"note":"main builds the 3×3 matrix arr.","vars":{},"structures":[{"kind":"grid","name":"arr","rows":[[1,2,3],[4,5,6],[7,8,9]],"rowLabels":["r0","r1","r2"],"colLabels":["c0","c1","c2"]}],"output":"","callStack":["main()"]},{"line":32,"note":"Call prtRowSum(arr, 3, 3): colsize = 3, rowsize = 3.","vars":{"colsize":3,"rowsize":3},"structures":[{"kind":"grid","name":"arr","rows":[[1,2,3],[4,5,6],[7,8,9]],"rowLabels":["r0","r1","r2"],"colLabels":["c0","c1","c2"]}],"output":"","callStack":["main()","prtRowSum(arr,3,3)"]},{"line":6,"note":"Outer loop picks row i = 0. Reset sum to 0 for this row.","vars":{"i":0,"sum":0},"structures":[{"kind":"grid","name":"arr","rows":[[1,2,3],[4,5,6],[7,8,9]],"rowLabels":["r0","r1","r2"],"colLabels":["c0","c1","c2"]}],"output":"","check":{"expr":"i < rowsize → 0 < 3","result":true},"loop":"row i = 0","callStack":["main()","prtRowSum(arr,3,3)"]},{"line":8,"note":"Add arr[0][0]. Row stays fixed (i), column j moves.","vars":{"i":0,"