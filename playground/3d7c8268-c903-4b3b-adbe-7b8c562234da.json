{"id":"3d7c8268-c903-4b3b-adbe-7b8c562234da","title":"Dry run: pivotIndex on [2,1,-1]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    int pivotIndex(vector<int>& nums) {\n        int size = nums.size();\n        int tsum = 0;\n        for(int i=0;i<size;i++){\n            tsum = tsum+nums[i];\n        }\n\n        int lsum = 0;\n        int rsum = tsum;\n\n        for(int i=1;i<size;i++){\n            lsum = lsum+nums[i-1];\n            rsum = tsum-lsum-nums[i];\n\n            if(lsum==rsum){\n                return i;\n            }\n        }\n\n        return -1;\n    }\n};","problem":"find-pivot-index","input":"nums = [2,1,-1]","expected":"0","createdAt":1792775152940,"steps":[{"line":4,"note":"Store the array size.","vars":{"size":3},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}],"calc":"size = 3","phase":"Total sum"},{"line":5,"note":"Start the total sum at 0.","vars":{"size":3,"tsum":0},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}]},{"line":7,"note":"Add nums[0] to the total.","vars":{"size":3,"tsum":2,"i":0},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":0},"highlight":[0]}],"moves":[{"from":"nums[0]","to":"tsum"}],"calc":"tsum = 0 + 2 = 2","loop":"i = 0"},{"line":7,"note":"Add nums[1] to the total.","vars":{"size":3,"tsum":3,"i":1},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":1},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"tsum"}],"calc":"tsum = 2 + 1 = 3","loop":"i = 1"},{"line":7,"note":"Add nums[2] to the total.","vars":{"size":3,"tsum":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":2},"highlight":[2]}],"moves":[{"from":"nums[2]","to":"tsum"}],"calc":"tsum = 3 + (-1) = 2","loop":"i = 2"},{"line":10,"note":"Nothing is to the left yet, so the left sum starts at 0.","vars":{"size":3,"tsum":2,"lsum":0},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}],"phase":"Scan for pivot"},{"line":11,"note":"rsum starts as the total sum.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}]},{"line":13,"note":"The loop starts at i = 1, so index 0 is never checked. Index 0 is the answer here: its left sum is 0 and its right sum is 1 + (-1) = 0.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":2,"i":1},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":1}}],"mistake":true,"check":{"expr":"i < size → 1 < 3","result":true},"loop":"i = 1"},{"line":14,"note":"Add the element just left of i to the left sum.","vars":{"size":3,"tsum":2,"lsum":2,"rsum":2,"i":1},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":1},"highlight":[0]}],"moves":[{"from":"nums[0]","to":"lsum"}],"calc":"lsum = 0 + nums[0] = 0 + 2 = 2","loop":"i = 1"},{"line":15,"note":"Right sum = total − left − current.","vars":{"size":3,"tsum":2,"lsum":2,"rsum":-1,"i":1},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":1},"highlight":[1]}],"calc":"rsum = 2 − 2 − 1 = -1","loop":"i = 1"},{"line":17,"note":"The sums don't match, so index 1 is not a pivot.","vars":{"size":3,"tsum":2,"lsum":2,"rsum":-1,"i":1},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":1}}],"check":{"expr":"lsum == rsum → 2 == -1","result":false},"loop":"i = 1"},{"line":13,"note":"Move on to i = 2.","vars":{"size":3,"tsum":2,"lsum":2,"rsum":-1,"i":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":2}}],"check":{"expr":"i < size → 2 < 3","result":true},"loop":"i = 2"},{"line":14,"note":"Add nums[1] to the left sum.","vars":{"size":3,"tsum":2,"lsum":3,"rsum":-1,"i":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":2},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"lsum"}],"calc":"lsum = 2 + 1 = 3","loop":"i = 2"},{"line":15,"note":"Index 2 is the last element, so its right sum should be 0.","vars":{"size":3,"tsum":2,"lsum":3,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":2},"highlight":[2]}],"calc":"rsum = 2 − 3 − (-1) = 0","loop":"i = 2"},{"line":17,"note":"The sums don't match, so index 2 is not a pivot.","vars":{"size":3,"tsum":2,"lsum":3,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[2,1,-1],"pointers":{"i":2}}],"check":{"expr":"lsum == rsum → 3 == 0","result":false},"loop":"i = 2"},{"line":13,"note":"i reaches size, so the loop ends.","vars":{"size":3,"tsum":2,"lsum":3,"rsum":0,"i":3},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}],"check":{"expr":"i < size → 3 < 3","result":false},"loop":"i = 3"},{"line":22,"note":"No index matched, so the code returns -1. The correct answer is 0.","vars":{"size":3,"tsum":2,"lsum":3,"rsum":0},"structures":[{"kind":"array","name":"nums","values":[2,1,-1]}],"output":"-1"}]}