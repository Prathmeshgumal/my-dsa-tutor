rent":[1,1]}],"check":{"expr":"result[1][1] == matrix[1][1] → 0 == 5","result":false},"loop":"i = 1 · j = 1"},{"line":10,"note":"Comparison only, nothing is written.","vars":{"rows":2,"col":3,"i":1,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[1,2]]},{"kind":"grid","name":"result","rows":[[0,0],[0,0],[0,0]],"current":[2,1]}],"check":{"expr":"result[2][1] == matrix[1][2] → 0 == 6","result":false},"loop":"i = 1 · j = 2"},{"line":14,"note":"The loops end. result has the right 3×2 shape but is all zeros. Expected [[1,4],[2,5],[3,6]].","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0],[0,0],[0,0]]}],"output":"[[0,0],[0,0],[0,0]]","check":{"expr":"i < rows → 2 < 2","result":false}}]}