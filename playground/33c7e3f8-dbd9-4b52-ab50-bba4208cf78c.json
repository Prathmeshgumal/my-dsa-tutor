{"id":"33c7e3f8-dbd9-4b52-ab50-bba4208cf78c","title":"Dry run: rotate on [1,2,3,4,5], k = 2 (j >= shift, fixed)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-shift;i<size;i++){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>=shift;j--){\n            nums[j] = nums[j-shift];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5], k = 2","createdAt":1792513456067,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":2,"size":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]}],"calc":"size = 5"},{"line":5,"note":"Each element moves 2 places right. Expected answer: [4,5,1,2,3].","vars":{"k":2,"size":5,"shift":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]}],"calc":"shift = 2 % 5 = 2"},{"line":7,"note":"Empty temp.","vars":{"size":5,"shift":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]},{"kind":"array","name":"temp","values":[],"capacity":0}]},{"line":9,"note":"Save loop starts at size-shift = 3. Save nums[3] = 4.","vars":{"size":5,"shift":2,"i":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"i":3},"highlight":[3]},{"kind":"array","name":"temp","values":[4],"capacity":1}],"moves":[{"from":"nums[3]","to":"temp[0]"}],"check":{"expr":"3 < 5","result":true},"loop":"save loop · i = 3"},{"line":9,"note":"i = 4: save nums[4] = 5.","vars":{"size":5,"shift":2,"i":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"i":4},"highlight":[4]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"moves":[{"from":"nums[4]","to":"temp[1]"}],"check":{"expr":"4 < 5","result":true},"loop":"save loop · i = 4"},{"line":8,"note":"i = 5: 5 < 5 is false, so the loop stops without going past the end. temp = [4, 5].","vars":{"size":5,"shift":2,"i":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"check":{"expr":"5 < 5","result":false},"loop":"save loop · i = 5"},{"line":13,"note":"Shift loop, j = 4: nums[4] = nums[2] = 3. Going right to left means we never overwrite a value before it has been moved.","vars":{"size":5,"shift":2,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,3],"pointers":{"j":4},"highlight":[2]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"moves":[{"from":"nums[2]","to":"nums[4]"}],"check":{"expr":"4 >= 2","result":true},"calc":"nums[4] = nums[4-2] = 3","loop":"shift loop · j = 4"},{"line":13,"note":"j = 3: nums[3] = nums[1] = 2.","vars":{"size":5,"shift":2,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,2,3],"pointers":{"j":3},"highlight":[1]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"moves":[{"from":"nums[1]","to":"nums[3]"}],"check":{"expr":"3 >= 2","result":true},"calc":"nums[3] = nums[3-2] = 2","loop":"shift loop · j = 3"},{"line":13,"note":"j = 2: nums[2] = nums[0] = 1. This is the last move. Indices 2..4 are final.","vars":{"size":5,"shift":2,"j":2},"structures":[{"kind":"array","name":"nums","values":[1,2,1,2,3],"pointers":{"j":2},"highlight":[0],"done":[2,3,4]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"moves":[{"from":"nums[0]","to":"nums[2]"}],"check":{"expr":"2 >= 2","result":true},"calc":"nums[2] = nums[2-2] = 1","loop":"shift loop · j = 2"},{"line":12,"note":"j = 1: 1 >= 2 is false, so the loop stops here. No more nums[-1] or nums[-2] reads. The smallest index ever read was nums[0].","vars":{"size":5,"shift":2,"j":1},"structures":[{"kind":"array","name":"nums","values":[1,2,1,2,3],"pointers":{"j":1},"done":[2,3,4]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}],"check":{"expr":"1 >= 2","result":false},"loop":"shift loop · j = 1"},{"line":17,"note":"Copy-back, k = 0: nums[0] = temp[0] = 4.","vars":{"size":5,"shift":2,"k":0},"structures":[{"kind":"array","name":"nums","values":[4,2,1,2,3],"pointers":{"k":0},"done":[0,2,3,4]},{"kind":"array","name":"temp","values":[4,5],"highlight":[0],"capacity":2}],"moves":[{"from":"temp[0]","to":"nums[0]"}],"check":{"expr":"0 < 2","result":true},"loop":"copy loop · k = 0"},{"line":17,"note":"k = 1: nums[1] = temp[1] = 5. Then k = 2 fails 2 < 2.","vars":{"size":5,"shift":2,"k":1},"structures":[{"kind":"array","name":"nums","values":[4,5,1,2,3],"pointers":{"k":1},"done":[0,1,2,3,4]},{"kind":"array","name":"temp","values":[4,5],"highlight":[1],"capacity":2}],"moves":[{"from":"temp[1]","to":"nums[1]"}],"check":{"expr":"1 < 2","result":true},"loop":"copy loop · k = 1"},{"line":19,"note":"Result [4,5,1,2,3]. Correct, and every read stayed inside the array.","vars":{"size":5,"shift":2},"structures":[{"kind":"array","name":"nums","values":[4,5,1,2,3],"done":[0,1,2,3,4]},{"kind":"array","name":"temp","values":[4,5],"capacity":2}]}]}