{"id":"69818005-a222-4032-aef9-d0c3a8bd916f","title":"Dry run: rotate on [-1,-100,3,99], k = 2 (full code)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-1;i>size-1-shift;i--){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>size-1-shift;j--){\n            nums[j] = nums[j-1];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [-1,-100,3,99], k = 2","createdAt":1792512291678,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":2,"size":4},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]}],"calc":"size = 4"},{"line":5,"note":"Reduce k modulo size.","vars":{"k":2,"size":4,"shift":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]}],"calc":"shift = 2 % 4 = 2"},{"line":9,"note":"First loop, i = 3: save nums[3] = 99.","vars":{"size":4,"shift":2,"i":3},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":3},"highlight":[3]},{"kind":"array","name":"temp","values":[99],"capacity":1}],"moves":[{"from":"nums[3]","to":"temp[0]"}],"check":{"expr":"3 > 1","result":true},"loop":"save loop · i = 3"},{"line":9,"note":"i = 2: save nums[2] = 3. Then i = 1 fails 1 > 1, so the loop ends. temp = [99, 3], which is reversed.","vars":{"size":4,"shift":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":2},"highlight":[2]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"moves":[{"from":"nums[2]","to":"temp[1]"}],"check":{"expr":"2 > 1","result":true},"loop":"save loop · i = 2"},{"line":12,"note":"Shift loop starts at j = 3 and runs while j > 1, the same range as the save loop, so it only runs 2 times.","vars":{"size":4,"shift":2,"j":3},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"j":3}},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"check":{"expr":"3 > 1","result":true},"loop":"shift loop · j = 3"},{"line":13,"note":"nums[3] = nums[j-1] = nums[2] = 3. This moves the element by only 1 place, but it should move by shift = 2: nums[3] should get nums[1] = -100.","vars":{"size":4,"shift":2,"j":3},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,3],"pointers":{"j":3},"highlight":[2]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"mistake":true,"moves":[{"from":"nums[2]","to":"nums[3]"}],"calc":"nums[3] = nums[2] = 3","loop":"shift loop · j = 3"},{"line":12,"note":"j = 2, still in range.","vars":{"size":4,"shift":2,"j":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,3],"pointers":{"j":2}},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"check":{"expr":"2 > 1","result":true},"loop":"shift loop · j = 2"},{"line":13,"note":"nums[2] = nums[1] = -100. Again a shift by 1 instead of 2.","vars":{"size":4,"shift":2,"j":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,-100,3],"pointers":{"j":2},"highlight":[1]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"moves":[{"from":"nums[1]","to":"nums[2]"}],"calc":"nums[2] = nums[1] = -100","loop":"shift loop · j = 2"},{"line":12,"note":"j = 1 fails 1 > 1, so the loop stops. But nums[0] = -1 was never moved, so -1 is lost from the array.","vars":{"size":4,"shift":2,"j":1},"structures":[{"kind":"array","name":"nums","values":[-1,-100,-100,3],"pointers":{"j":1}},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"mistake":true,"check":{"expr":"1 > 1","result":false},"loop":"shift loop · j = 1"},{"line":17,"note":"Copy-back loop, k = 0: nums[0] = temp[0] = 99.","vars":{"size":4,"shift":2,"k":0},"structures":[{"kind":"array","name":"nums","values":[99,-100,-100,3],"pointers":{"k":0}},{"kind":"array","name":"temp","values":[99,3],"highlight":[0],"capacity":2}],"moves":[{"from":"temp[0]","to":"nums[0]"}],"check":{"expr":"0 < 2","result":true},"loop":"copy loop · k = 0"},{"line":17,"note":"k = 1: nums[1] = temp[1] = 3. Because temp is reversed, the front becomes 99, 3 instead of 3, 99.","vars":{"size":4,"shift":2,"k":1},"structures":[{"kind":"array","name":"nums","values":[99,3,-100,3],"pointers":{"k":1}},{"kind":"array","name":"temp","values":[99,3],"highlight":[1],"capacity":2}],"mistake":true,"moves":[{"from":"temp[1]","to":"nums[1]"}],"check":{"expr":"1 < 2","result":true},"loop":"copy loop · k = 1"},{"line":19,"note":"Result [99, 3, -100, 3], expected [3, 99, -1, -100].","vars":{"size":4,"shift":2},"structures":[{"kind":"array","name":"nums","values":[99,3,-100,3]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}]}]}