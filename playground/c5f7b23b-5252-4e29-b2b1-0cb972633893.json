{"id":"c5f7b23b-5252-4e29-b2b1-0cb972633893","title":"Dry run: rotate (transpose + column swaps) on [[1,2,3],[4,5,6],[7,8,9]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<vector<int>>& matrix) {\n        int size = matrix.size();\n\n        for(int i=0;i<size;i++){\n            for(int j=i;j<size;j++){\n                swap(matrix[i][j],matrix[j][i]);\n            }\n        }\n        int i=0;\n        int j=size-1;\n        while(j>=i){\n            for(int k=0;k<size;k++){\n                swap(matrix[k][i],matrix[k][j]);\n            }\n            i++;\n            j--;\n        }\n\n    }\n};","problem":"rotate-image-2","input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792689239289,"steps":[{"line":4,"note":"Store the size.","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]}],"calc":"size = 3"},{"line":8,"note":"Phase 1 (transpose). Diagonal cells swap with themselves, so they don't change. The first real swap is 2 ↔ 4.","vars":{"size":3,"i":0,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,4,3],[2,5,6],[7,8,9]],"current":[0,1],"highlight":[[1,0]]}],"moves":[{"from":"matrix[0][1]","to":"matrix[1][0]","label":"2"},{"from":"matrix[1][0]","to":"matrix[0][1]","label":"4"}],"calc":"swap(matrix[0][1], matrix[1][0]) → 2 ↔ 4","loop":"transpose · i = 0 · j = 1"},{"line":8,"note":"3 ↔ 7.","vars":{"size":3,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,4,7],[2,5,6],[3,8,9]],"current":[0,2],"highlight":[[2,0]]}],"moves":[{"from":"matrix[0][2]","to":"matrix[2][0]","label":"3"},{"from":"matrix[2][0]","to":"matrix[0][2]","label":"7"}],"calc":"swap(matrix[0][2], matrix[2][0]) → 3 ↔ 7","loop":"transpose · i = 0 · j = 2"},{"line":8,"note":"6 ↔ 8. The transpose is done: rows have become columns.","vars":{"size":3,"i":1,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,4,7],[2,5,8],[3,6,9]],"current":[1,2],"highlight":[[2,1]]}],"moves":[{"from":"matrix[1][2]","to":"matrix[2][1]","label":"6"},{"from":"matrix[2][1]","to":"matrix[1][2]","label":"8"}],"calc":"swap(matrix[1][2], matrix[2][1]) → 6 ↔ 8","loop":"transpose · i = 1 · j = 2"},{"line":12,"note":"Phase 2: new i and j point at the leftmost and rightmost columns.","vars":{"size":3,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,4,7],[2,5,8],[3,6,9]],"colLabels":["i","","j"]}],"calc":"i = 0, j = size-1 = 2"},{"line":13,"note":"The columns haven't met yet.","vars":{"size":3,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,4,7],[2,5,8],[3,6,9]],"colLabels":["i","","j"]}],"check":{"expr":"j >= i → 2 >= 0","result":true}},{"line":15,"note":"Row 0: swap column 0 and column 2.","vars":{"size":3,"i":0,"j":2,"k":0},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[2,5,8],[3,6,9]],"colLabels":["i","","j"],"current":[0,0],"highlight":[[0,2]]}],"moves":[{"from":"matrix[0][0]","to":"matrix[0][2]","label":"1"},{"from":"matrix[0][2]","to":"matrix[0][0]","label":"7"}],"calc":"swap(matrix[0][0], matrix[0][2]) → 1 ↔ 7","loop":"i = 0, j = 2 · k = 0"},{"line":15,"note":"Row 1: 2 ↔ 8.","vars":{"size":3,"i":0,"j":2,"k":1},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[3,6,9]],"colLabels":["i","","j"],"current":[1,0],"highlight":[[1,2]]}],"moves":[{"from":"matrix[1][0]","to":"matrix[1][2]","label":"2"},{"from":"matrix[1][2]","to":"matrix[1][0]","label":"8"}],"calc":"swap(matrix[1][0], matrix[1][2]) → 2 ↔ 8","loop":"i = 0, j = 2 · k = 1"},{"line":15,"note":"Row 2: 3 ↔ 9. Columns 0 and 2 have now fully traded places.","vars":{"size":3,"i":0,"j":2,"k":2},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]],"colLabels":["i","","j"],"current":[2,0],"highlight":[[2,2]]}],"moves":[{"from":"matrix[2][0]","to":"matrix[2][2]","label":"3"},{"from":"matrix[2][2]","to":"matrix[2][0]","label":"9"}],"calc":"swap(matrix[2][0], matrix[2][2]) → 3 ↔ 9","loop":"i = 0, j = 2 · k = 2"},{"line":18,"note":"Move both pointers inward.","vars":{"size":3,"i":1,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]],"colLabels":["","i=j",""]}],"calc":"i = 0+1 = 1, j = 2-1 = 1"},{"line":13,"note":"i == j, so the loop runs once more on the middle column.","vars":{"size":3,"i":1,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]],"colLabels":["","i=j",""]}],"check":{"expr":"j >= i → 1 >= 1","result":true}},{"line":15,"note":"For k = 0..2 it swaps matrix[k][1] with itself (4, 5, 6). Nothing changes: 3 wasted swaps, but no harm. Using j > i would skip them.","vars":{"size":3,"i":1,"j":1,"k":2},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]],"colLabels":["","i=j",""],"highlight":[[0,1],[1,1],[2,1]]}],"calc":"swap(matrix[k][1], matrix[k][1]) for k = 0,1,2","loop":"i = 1, j = 1 · k = 0..2"},{"line":18,"note":"Pointers cross.","vars":{"size":3,"i":2,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]],"colLabels":["j","","i"]}],"calc":"i = 2, j = 0"},{"line":13,"note":"Loop ends.","vars":{"size":3,"i":2,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]]}],"check":{"expr":"j >= i → 0 >= 2","result":false}},{"line":21,"note":"Final matrix [[7,4,1],[8,5,2],[9,6,3]] matches the expected output. ✅","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[7,4,1],[8,5,2],[9,6,3]]},{"kind":"grid","name":"expected","rows":[[7,4,1],[8,5,2],[9,6,3]]}]}]}