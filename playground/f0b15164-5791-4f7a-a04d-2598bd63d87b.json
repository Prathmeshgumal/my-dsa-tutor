{"id":"f0b15164-5791-4f7a-a04d-2598bd63d87b","title":"Dry run: rotate on [1,2,3,4,5,6,7], k = 3 (new save loop)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-shift+1;i<=size;i++){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>=size-1-shift;j--){\n            nums[j] = nums[j-shift];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5,6,7], k = 3","createdAt":1792512931986,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":3,"size":7},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"size = 7"},{"line":5,"note":"Each element moves 3 places right.","vars":{"k":3,"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"shift = 3 % 7 = 3"},{"line":7,"note":"Empty temp.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]},{"kind":"array","name":"temp","values":[],"capacity":0}]},{"line":8,"note":"i starts at size-shift+1 = 5. But the last 3 elements start at index size-shift = 4 (value 5). Starting at 5 skips the 5.","vars":{"size":7,"shift":3,"i":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":5},"highlight":[4]},{"kind":"array","name":"temp","values":[],"capacity":0}],"mistake":true,"check":{"expr":"5 <= 7","result":true},"calc":"i = 7 - 3 + 1 = 5","loop":"save loop · i = 5"},{"line":9,"note":"Save nums[5] = 6. The order is forward now, which is good.","vars":{"size":7,"shift":3,"i":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":5},"highlight":[5]},{"kind":"array","name":"temp","values":[6],"capacity":1}],"moves":[{"from":"nums[5]","to":"temp[0]"}],"loop":"save loop · i = 5"},{"line":9,"note":"i = 6: save nums[6] = 7.","vars":{"size":7,"shift":3,"i":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":6},"highlight":[6]},{"kind":"array","name":"temp","values":[6,7],"capacity":2}],"moves":[{"from":"nums[6]","to":"temp[1]"}],"check":{"expr":"6 <= 7","result":true},"loop":"save loop · i = 6"},{"line":8,"note":"i = 7: 7 <= 7 is true, but valid indices are only 0..6. With <= size, the loop reads past the end.","vars":{"size":7,"shift":3,"i":7},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":7}},{"kind":"array","name":"temp","values":[6,7],"capacity":2}],"mistake":true,"check":{"expr":"7 <= 7","result":true},"loop":"save loop · i = 7"},{"line":9,"note":"nums[7] is out of bounds (undefined behaviour). In this run it read 0, which is garbage memory, and pushed it.","vars":{"size":7,"shift":3,"i":7},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":7}},{"kind":"array","name":"temp","values":[6,7,0],"highlight":[2],"capacity":4}],"mistake":true,"calc":"temp.push_back(nums[7]) → garbage (0)","loop":"save loop · i = 7"},{"line":8,"note":"i = 8: 8 <= 7 is false, so the loop is done. temp = [6, 7, 0] but should be [5, 6, 7].","vars":{"size":7,"shift":3,"i":8},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}],"check":{"expr":"8 <= 7","result":false},"loop":"save loop · i = 8"},{"line":13,"note":"Shift loop (j >= size-1-shift = 3), j = 6: nums[6] = nums[3] = 4.","vars":{"size":7,"shift":3,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,4],"pointers":{"j":6},"highlight":[3]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}],"moves":[{"from":"nums[3]","to":"nums[6]"}],"check":{"expr":"6 >= 3","result":true},"calc":"nums[6] = nums[3] = 4","loop":"shift loop · j = 6"},{"line":13,"note":"j = 5: nums[5] = nums[2] = 3.","vars":{"size":7,"shift":3,"j":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,3,4],"pointers":{"j":5},"highlight":[2]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}],"moves":[{"from":"nums[2]","to":"nums[5]"}],"check":{"expr":"5 >= 3","result":true},"calc":"nums[5] = nums[2] = 3","loop":"shift loop · j = 5"},{"line":13,"note":"j = 4: nums[4] = nums[1] = 2.","vars":{"size":7,"shift":3,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,2,3,4],"pointers":{"j":4},"highlight":[1]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}],"moves":[{"from":"nums[1]","to":"nums[4]"}],"check":{"expr":"4 >= 3","result":true},"calc":"nums[4] = nums[1] = 2","loop":"shift loop · j = 4"},{"line":13,"note":"j = 3: nums[3] = nums[0] = 1. Then j = 2 fails 2 >= 3. The shift part is right for this input (size-1-shift happens to equal shift here).","vars":{"size":7,"shift":3,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,1,2,3,4],"pointers":{"j":3},"highlight":[0],"done":[3,4,5,6]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}],"moves":[{"from":"nums[0]","to":"nums[3]"}],"check":{"expr":"3 >= 3","result":true},"calc":"nums[3] = nums[0] = 1","loop":"shift loop · j = 3"},{"line":17,"note":"Copy-back, k = 0: nums[0] = temp[0] = 6 (should be 5).","vars":{"size":7,"shift":3,"k":0},"structures":[{"kind":"array","name":"nums","values":[6,2,3,1,2,3,4],"pointers":{"k":0},"done":[3,4,5,6]},{"kind":"array","name":"temp","values":[6,7,0],"highlight":[0],"capacity":4}],"moves":[{"from":"temp[0]","to":"nums[0]"}],"check":{"expr":"0 < 3","result":true},"loop":"copy loop · k = 0"},{"line":17,"note":"k = 1: nums[1] = temp[1] = 7 (should be 6).","vars":{"size":7,"shift":3,"k":1},"structures":[{"kind":"array","name":"nums","values":[6,7,3,1,2,3,4],"pointers":{"k":1},"done":[3,4,5,6]},{"kind":"array","name":"temp","values":[6,7,0],"highlight":[1],"capacity":4}],"moves":[{"from":"temp[1]","to":"nums[1]"}],"check":{"expr":"1 < 3","result":true},"loop":"copy loop · k = 1"},{"line":17,"note":"k = 2: nums[2] = temp[2] = 0, the garbage value (should be 7).","vars":{"size":7,"shift":3,"k":2},"structures":[{"kind":"array","name":"nums","values":[6,7,0,1,2,3,4],"pointers":{"k":2},"done":[3,4,5,6]},{"kind":"array","name":"temp","values":[6,7,0],"highlight":[2],"capacity":4}],"moves":[{"from":"temp[2]","to":"nums[2]"}],"check":{"expr":"2 < 3","result":true},"loop":"copy loop · k = 2"},{"line":19,"note":"Result [6,7,0,1,2,3,4], expected [5,6,7,1,2,3,4]. Everything in the front is off by one index because of the save loop.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[6,7,0,1,2,3,4],"done":[3,4,5,6]},{"kind":"array","name":"temp","values":[6,7,0],"capacity":4}]}]}