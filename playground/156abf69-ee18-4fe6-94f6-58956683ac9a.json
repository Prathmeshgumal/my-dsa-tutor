{"id":"156abf69-ee18-4fe6-94f6-58956683ac9a","title":"Dry run: rotate on [1,2,3,4,5], k = 1 (j >= size-1-shift)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-1;i>size-1-shift;i--){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>=size-1-shift;j--){\n            nums[j] = nums[j-shift];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5], k = 1","createdAt":1792512619669,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":1,"size":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]}],"calc":"size = 5"},{"line":5,"note":"Each element should move 1 place right.","vars":{"k":1,"size":5,"shift":1},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5]}],"calc":"shift = 1 % 5 = 1"},{"line":8,"note":"Save loop runs while i > size-1-shift = 3.","vars":{"size":5,"shift":1,"i":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"i":4}},{"kind":"array","name":"temp","values":[],"capacity":0}],"check":{"expr":"4 > 3","result":true},"loop":"save loop · i = 4"},{"line":9,"note":"Save nums[4] = 5. Only one element, so the reversed order doesn't matter in this case.","vars":{"size":5,"shift":1,"i":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"i":4},"highlight":[4]},{"kind":"array","name":"temp","values":[5],"capacity":1}],"moves":[{"from":"nums[4]","to":"temp[0]"}],"loop":"save loop · i = 4"},{"line":8,"note":"i = 3: 3 > 3 is false, so the save loop is done.","vars":{"size":5,"shift":1,"i":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"i":3}},{"kind":"array","name":"temp","values":[5],"capacity":1}],"check":{"expr":"3 > 3","result":false},"loop":"save loop · i = 3"},{"line":12,"note":"Shift loop runs while j >= size-1-shift = 3. But 4 elements (1,2,3,4) need to move, which means j should go down to shift = 1.","vars":{"size":5,"shift":1,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5],"pointers":{"j":4}},{"kind":"array","name":"temp","values":[5],"capacity":1}],"check":{"expr":"4 >= 3","result":true},"loop":"shift loop · j = 4"},{"line":13,"note":"nums[4] = nums[3] = 4. Correct.","vars":{"size":5,"shift":1,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,4],"pointers":{"j":4},"highlight":[3]},{"kind":"array","name":"temp","values":[5],"capacity":1}],"moves":[{"from":"nums[3]","to":"nums[4]"}],"calc":"nums[4] = nums[4-1] = 4","loop":"shift loop · j = 4"},{"line":12,"note":"j = 3, still in range.","vars":{"size":5,"shift":1,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,4],"pointers":{"j":3}},{"kind":"array","name":"temp","values":[5],"capacity":1}],"check":{"expr":"3 >= 3","result":true},"loop":"shift loop · j = 3"},{"line":13,"note":"nums[3] = nums[2] = 3. Correct.","vars":{"size":5,"shift":1,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,3,4],"pointers":{"j":3},"highlight":[2]},{"kind":"array","name":"temp","values":[5],"capacity":1}],"moves":[{"from":"nums[2]","to":"nums[3]"}],"calc":"nums[3] = nums[3-1] = 3","loop":"shift loop · j = 3"},{"line":12,"note":"j = 2: 2 >= 3 is false, so the loop stops. But j = 2 (nums[2] = nums[1]) and j = 1 (nums[1] = nums[0]) never run, so 1 and 2 are never shifted. The bound should be j >= shift, which is 1 here.","vars":{"size":5,"shift":1,"j":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3,3,4],"pointers":{"j":2},"highlight":[0,1]},{"kind":"array","name":"temp","values":[5],"capacity":1}],"mistake":true,"check":{"expr":"2 >= 3","result":false},"loop":"shift loop · j = 2"},{"line":17,"note":"Copy-back loop, k = 0: nums[0] = temp[0] = 5. This part is right.","vars":{"size":5,"shift":1,"k":0},"structures":[{"kind":"array","name":"nums","values":[5,2,3,3,4],"pointers":{"k":0}},{"kind":"array","name":"temp","values":[5],"highlight":[0],"capacity":1}],"moves":[{"from":"temp[0]","to":"nums[0]"}],"check":{"expr":"0 < 1","result":true},"loop":"copy loop · k = 0"},{"line":19,"note":"Result [5,2,3,3,4], expected [5,1,2,3,4]. The 1 is lost and 3 appears twice, both because the shift loop stopped early.","vars":{"size":5,"shift":1},"structures":[{"kind":"array","name":"nums","values":[5,2,3,3,4]},{"kind":"array","name":"temp","values":[5],"capacity":1}]}]}