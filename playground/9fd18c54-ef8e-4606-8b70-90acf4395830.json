{"id":"9fd18c54-ef8e-4606-8b70-90acf4395830","title":"Dry run: printExtremeElementsAlternately on [3,1,2]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> printExtremeElementsAlternately(vector<int>& arr) {\n        sort(arr.begin(),arr.end());\n        int size = arr.size();\n        int start = 0;\n        int end = size-1;\n        vector<int>ans;\n        if(size%2 ==0){\n            while(start<end){\n                ans.push_back(arr[start]);\n                start++;\n                ans.push_back(arr[end]);\n                end--;\n            }\n        }\n        else{\n            while(start<=end){\n                ans.push_back(arr[start]);\n                start++;\n                ans.push_back(arr[end]);\n                end--;\n            }\n        }\n        return ans;\n    }\n};","problem":"print-extreme-elements-alternately","input":"arr = [3,1,2]","expected":"[1,3,2]","createdAt":1792690782176,"steps":[{"line":4,"note":"Sort the array in ascending order.","vars":{},"structures":[{"kind":"array","name":"arr","values":[1,2,3]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","phase":"Setup"},{"line":5,"note":"Store the number of elements.","vars":{"size":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","calc":"size = 3"},{"line":6,"note":"start points at the smallest element.","vars":{"size":3,"start":0},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":""},{"line":7,"note":"end points at the largest element.","vars":{"size":3,"start":0,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0,"end":2}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","calc":"end = 3 - 1 = 2"},{"line":8,"note":"Create an empty answer vector.","vars":{"size":3,"start":0,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0,"end":2}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":""},{"line":9,"note":"The size is odd, so the else branch runs.","vars":{"size":3,"start":0,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0,"end":2}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","check":{"expr":"size % 2 == 0 → 3 % 2 = 1 == 0","result":false}},{"line":18,"note":"The pointers haven't crossed, so the loop runs.","vars":{"size":3,"start":0,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0,"end":2},"highlight":[0,2]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","check":{"expr":"start <= end → 0 <= 2","result":true},"loop":"iteration 1","phase":"Odd loop"},{"line":19,"note":"Push the smallest remaining value.","vars":{"size":3,"start":0,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":0,"end":2},"highlight":[0]},{"kind":"array","name":"ans","values":[1],"capacity":1}],"output":"","moves":[{"from":"arr[0]","to":"ans[0]","label":"1"}],"loop":"iteration 1"},{"line":20,"note":"Move start right.","vars":{"size":3,"start":1,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":1,"end":2}},{"kind":"array","name":"ans","values":[1],"capacity":1}],"output":"","calc":"start = 0 + 1 = 1","loop":"iteration 1"},{"line":21,"note":"Push the largest remaining value.","vars":{"size":3,"start":1,"end":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":1,"end":2},"highlight":[2]},{"kind":"array","name":"ans","values":[1,3],"capacity":2}],"output":"","moves":[{"from":"arr[2]","to":"ans[1]","label":"3"}],"loop":"iteration 1"},{"line":22,"note":"Move end left. Now start and end point at the same middle element.","vars":{"size":3,"start":1,"end":1},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":1,"end":1}},{"kind":"array","name":"ans","values":[1,3],"capacity":2}],"output":"","calc":"end = 2 - 1 = 1","loop":"iteration 1"},{"line":18,"note":"start == end, so `<=` lets the loop run once more for the middle element.","vars":{"size":3,"start":1,"end":1},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":1,"end":1},"highlight":[1]},{"kind":"array","name":"ans","values":[1,3],"capacity":2}],"output":"","check":{"expr":"start <= end → 1 <= 1","result":true},"loop":"iteration 2"},{"line":19,"note":"Push the middle element 2. This is correct, and ans is now complete.","vars":{"size":3,"start":1,"end":1},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":1,"end":1},"highlight":[1]},{"kind":"array","name":"ans","values":[1,3,2],"capacity":4}],"output":"","moves":[{"from":"arr[1]","to":"ans[2]","label":"2"}],"loop":"iteration 2"},{"line":20,"note":"Move start right.","vars":{"size":3,"start":2,"end":1},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":2,"end":1}},{"kind":"array","name":"ans","values":[1,3,2],"capacity":4}],"output":"","calc":"start = 1 + 1 = 2","loop":"iteration 2"},{"line":21,"note":"Bug: end still points at the middle element, which was just pushed. Line 21 runs anyway, so 2 is added a second time. Nothing checks whether start and end were the same element.","vars":{"size":3,"start":2,"end":1},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":2,"end":1},"highlight":[1]},{"kind":"array","name":"ans","values":[1,3,2,2],"highlight":[3],"capacity":4}],"output":"","mistake":true,"moves":[{"from":"arr[1]","to":"ans[3]","label":"2 again"}],"loop":"iteration 2"},{"line":22,"note":"Move end left.","vars":{"size":3,"start":2,"end":0},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":2,"end":0}},{"kind":"array","name":"ans","values":[1,3,2,2],"capacity":4}],"output":"","calc":"end = 1 - 1 = 0","loop":"iteration 2"},{"line":18,"note":"The pointers have crossed, so the loop ends.","vars":{"size":3,"start":2,"end":0},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":2,"end":0}},{"kind":"array","name":"ans","values":[1,3,2,2],"capacity":4}],"output":"","check":{"expr":"start <= end → 2 <= 0","result":false},"phase":"Return"},{"line":25,"note":"Return ans. It has 4 elements, but the input had only 3.","vars":{"size":3,"start":2,"end":0},"structures":[{"kind":"array","name":"arr","values":[1,2,3],"pointers":{"start":2,"end":0}},{"kind":"array","name":"ans","values":[1,3,2,2],"highlight":[2,3],"capacity":4}],"output":"[1,3,2,2]"}]}