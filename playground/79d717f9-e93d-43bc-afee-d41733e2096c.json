{"id":"79d717f9-e93d-43bc-afee-d41733e2096c","title":"Dry run (fixed): solution-2 diagonalSum on [[1,2,3],[4,5,6],[7,8,9]]","file":"solution-2.cpp","language":"cpp","code":"class Solution {\npublic:\n    int diagonalSum(vector<vector<int>>& mat) {\n        int size = mat.size();\n        int sum = 0;\n        \n        for(int i=0;i<size;i++){\n            sum = sum + mat[i][i];\n        }\n\n        for(int j=0;j<size;j++){\n            sum = sum + mat[j][size-1-j];\n        }\n\n        if(size%2 != 0){\n            sum = sum - mat[size/2][size/2];\n        }\n\n        return sum;\n    }\n};","problem":"matrix-diagonal-sum","input":"mat = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792603113754,"steps":[{"line":4,"note":"Get the size of the matrix.","vars":{"size":3},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]]}],"calc":"size = mat.size() = 3"},{"line":5,"note":"Start the total at 0.","vars":{"size":3,"sum":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]]}]},{"line":8,"note":"Primary loop: add mat[0][0].","vars":{"size":3,"sum":1,"i":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]}],"calc":"sum = 0 + mat[0][0] = 0 + 1 = 1","loop":"primary loop · i = 0"},{"line":8,"note":"Add mat[1][1]. This is the first time the center is counted.","vars":{"size":3,"sum":6,"i":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0]]}],"calc":"sum = 1 + mat[1][1] = 1 + 5 = 6","loop":"primary loop · i = 1"},{"line":8,"note":"Add mat[2][2]. The primary diagonal totals 15.","vars":{"size":3,"sum":15,"i":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2],"highlight":[[0,0],[1,1]]}],"calc":"sum = 6 + mat[2][2] = 6 + 9 = 15","loop":"primary loop · i = 2"},{"line":12,"note":"Secondary loop: column = 3-1-0 = 2. Add mat[0][2].","vars":{"size":3,"sum":18,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2],"highlight":[[0,0],[1,1],[2,2]]}],"calc":"sum = 15 + mat[0][2] = 15 + 3 = 18","loop":"secondary loop · j = 0"},{"line":12,"note":"Column = 3-1-1 = 1, so the center mat[1][1] is added a second time. The if on line 15 will undo this.","vars":{"size":3,"sum":23,"j":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0],[1,1],[2,2],[0,2]]}],"calc":"sum = 18 + mat[1][1] = 18 + 5 = 23","loop":"secondary loop · j = 1"},{"line":12,"note":"Column = 0. Add mat[2][0].","vars":{"size":3,"sum":30,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0],"highlight":[[0,0],[1,1],[2,2],[0,2]]}],"calc":"sum = 23 + mat[2][0] = 23 + 7 = 30","loop":"secondary loop · j = 2"},{"line":15,"note":"Fixed condition: the size is odd, so the diagonals share the center cell and the extra copy must be removed.","vars":{"size":3,"sum":30},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0],[2,2],[0,2],[2,0]]}],"check":{"expr":"size % 2 != 0 → 3 % 2 = 1 != 0","result":true}},{"line":16,"note":"Subtract the center mat[3/2][3/2] = mat[1][1] once, so it's counted only once overall.","vars":{"size":3,"sum":25},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0],[2,2],[0,2],[2,0]]}],"calc":"sum = 30 - mat[1][1] = 30 - 5 = 25"},{"line":19,"note":"Return 25 = 1 + 5 + 9 + 3 + 7. Correct!","vars":{"size":3,"sum":25},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[0,0],[1,1],[2,2],[0,2],[2,0]]}]}]}