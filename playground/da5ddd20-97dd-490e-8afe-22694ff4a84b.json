{"id":"da5ddd20-97dd-490e-8afe-22694ff4a84b","title":"Dry run: shiftRight on [1,2,3,4]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> shiftRight(vector<int>& arr) {\n        int size = arr.size();\n        if(size ==0){\n            return arr;\n        }\n        \n        else{\n            int end = arr[size-1];\n            for(int i=size-1;i>0;i--){\n            arr[i] = arr[i-1];\n        }\n        arr[0] = end;\n        }\n        return arr;\n    }\n};","problem":"shift-array-elements-by-one-position","input":"arr = [1,2,3,4]","createdAt":1792510947890,"steps":[{"line":4,"note":"Store the array's length.","vars":{"size":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4]}],"calc":"size = arr.size() = 4"},{"line":5,"note":"The array isn't empty, so we go into the else branch.","vars":{"size":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4]}],"check":{"expr":"size == 0 → 4 == 0","result":false}},{"line":10,"note":"Save the last element before it gets overwritten. It goes to the front at the end.","vars":{"size":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4],"highlight":[3]}],"moves":[{"from":"arr[3]","to":"end","label":"save"}],"calc":"end = arr[3] = 4"},{"line":11,"note":"Start from the back: i = size-1 = 3.","vars":{"size":4,"end":4,"i":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4],"pointers":{"i":3}}],"check":{"expr":"i > 0 → 3 > 0","result":true},"loop":"i = 3"},{"line":12,"note":"Copy the left neighbour into position 3. The old 4 is safe in end.","vars":{"size":4,"end":4,"i":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3,3],"pointers":{"i":3},"highlight":[2,3]}],"moves":[{"from":"arr[2]","to":"arr[3]"}],"calc":"arr[3] = arr[2] = 3","loop":"i = 3"},{"line":11,"note":"i-- → 2.","vars":{"size":4,"end":4,"i":2},"structures":[{"kind":"array","name":"arr","values":[1,2,3,3],"pointers":{"i":2}}],"check":{"expr":"i > 0 → 2 > 0","result":true},"loop":"i = 2"},{"line":12,"note":"Shift 2 one step right.","vars":{"size":4,"end":4,"i":2},"structures":[{"kind":"array","name":"arr","values":[1,2,2,3],"pointers":{"i":2},"highlight":[1,2]}],"moves":[{"from":"arr[1]","to":"arr[2]"}],"calc":"arr[2] = arr[1] = 2","loop":"i = 2"},{"line":11,"note":"i-- → 1.","vars":{"size":4,"end":4,"i":1},"structures":[{"kind":"array","name":"arr","values":[1,2,2,3],"pointers":{"i":1}}],"check":{"expr":"i > 0 → 1 > 0","result":true},"loop":"i = 1"},{"line":12,"note":"Shift 1 one step right.","vars":{"size":4,"end":4,"i":1},"structures":[{"kind":"array","name":"arr","values":[1,1,2,3],"pointers":{"i":1},"highlight":[0,1]}],"moves":[{"from":"arr[0]","to":"arr[1]"}],"calc":"arr[1] = arr[0] = 1","loop":"i = 1"},{"line":11,"note":"i-- → 0. The loop stops, so arr[0] is never read as arr[-1].","vars":{"size":4,"end":4,"i":0},"structures":[{"kind":"array","name":"arr","values":[1,1,2,3],"pointers":{"i":0}}],"check":{"expr":"i > 0 → 0 > 0","result":false},"loop":"i = 0"},{"line":14,"note":"The saved last element wraps around to the front.","vars":{"size":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[4,1,2,3],"highlight":[0],"done":[0,1,2,3]}],"moves":[{"from":"end","to":"arr[0]","label":"wrap"}],"calc":"arr[0] = end = 4"},{"line":16,"note":"Return the rotated array: [4,1,2,3] ✅","vars":{"size":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[4,1,2,3],"done":[0,1,2,3]}],"output":"[4,1,2,3]"}]}