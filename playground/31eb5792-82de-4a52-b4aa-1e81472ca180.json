{"id":"31eb5792-82de-4a52-b4aa-1e81472ca180","title":"Dry run: rotate on [-1,-100,3,99], k = 2","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-1;i>size-1-shift;i--){\n            temp.push_back(nums[i]);\n        }\n\n        \n    }\n};","problem":"rotate-an-array","input":"nums = [-1,-100,3,99], k = 2","createdAt":1792512045193,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":2,"size":4},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]}],"calc":"size = nums.size() = 4"},{"line":5,"note":"Reduce k so it's never bigger than the array.","vars":{"k":2,"size":4,"shift":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]}],"calc":"shift = 2 % 4 = 2"},{"line":7,"note":"Create an empty vector temp.","vars":{"k":2,"size":4,"shift":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]},{"kind":"array","name":"temp","values":[],"capacity":0}]},{"line":8,"note":"Start at the last index; loop while i > size-1-shift = 1.","vars":{"k":2,"size":4,"shift":2,"i":3},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":3}},{"kind":"array","name":"temp","values":[],"capacity":0}],"check":{"expr":"i > size-1-shift → 3 > 1","result":true},"loop":"i = 3"},{"line":9,"note":"Copy nums[3] = 99 into temp.","vars":{"k":2,"size":4,"shift":2,"i":3},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":3},"highlight":[3]},{"kind":"array","name":"temp","values":[99],"capacity":1}],"moves":[{"from":"nums[3]","to":"temp[0]"}],"loop":"i = 3"},{"line":8,"note":"i-- → 2, still in range.","vars":{"k":2,"size":4,"shift":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":2}},{"kind":"array","name":"temp","values":[99],"capacity":1}],"check":{"expr":"2 > 1","result":true},"loop":"i = 2"},{"line":9,"note":"Copy nums[2] = 3 into temp.","vars":{"k":2,"size":4,"shift":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":2},"highlight":[2]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"moves":[{"from":"nums[2]","to":"temp[1]"}],"loop":"i = 2"},{"line":8,"note":"i-- → 1. 1 > 1 is false, so the loop stops after saving the last 2 elements.","vars":{"k":2,"size":4,"shift":2,"i":1},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99],"pointers":{"i":1}},{"kind":"array","name":"temp","values":[99,3],"capacity":2}],"check":{"expr":"1 > 1","result":false},"loop":"i = 1"},{"line":13,"note":"The function ends. temp = [99,3] (reversed: the answer starts 3, 99), and nums was never changed, so the output is [-1,-100,3,99] instead of [3,99,-1,-100].","vars":{"k":2,"size":4,"shift":2},"structures":[{"kind":"array","name":"nums","values":[-1,-100,3,99]},{"kind":"array","name":"temp","values":[99,3],"capacity":2}]}]}