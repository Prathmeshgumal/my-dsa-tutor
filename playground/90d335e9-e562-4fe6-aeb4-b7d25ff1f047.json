{"id":"90d335e9-e562-4fe6-aeb4-b7d25ff1f047","title":"Dry run: pivotIndex on [1,7,3,6,5,6]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    int pivotIndex(vector<int>& nums) {\n        int size = nums.size();\n        int tsum = 0;\n        for(int i=0;i<size;i++){\n            tsum = tsum+nums[i];\n        }\n\n        int lsum = 0;\n        int rsum = tsum-nums[0];\n\n        for(int i=0;i<size;i++){\n\n            if(lsum==rsum){\n                return i;\n            }\n            lsum = lsum+nums[i];\n            if(i+1<size){\n                rsum = rsum-nums[i+1];\n            }\n        }\n\n        return -1;\n    }\n};","problem":"find-pivot-index","input":"nums = [1,7,3,6,5,6]","expected":"3","createdAt":1792776548986,"steps":[{"line":4,"note":"Store the array size.","vars":{"size":6},"structures":[{"kind":"array","name":"nums","values":[1,7,3,6,5,6]}],"calc":"size = 6","phase":"Total sum"},{"line":7,"note":"Add nums[0] to the total.","vars":{"size":6,"tsum":1,"i":0},"structures":[{"kind":"array","name":"nums","values":[1,7,3,6,5,6],"pointers":{"i":0},"highlight":[0]}],"moves":[{"from":"nums[0]","to":"tsum"}],"calc":"tsum = 0 + 1 = 1","loop":"i = 0"},{"line":7,"note":"Add nums[1] to the total.","vars":{"size":6,"tsum":8,"i":1},"structures":[{"kind":"array","name":"nums","values":[1,7,3,6,5,6],"pointers":{"i":1},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"tsum"}],"calc":"tsum = 1 + 7 = 8","loop":"i = 1"},{"line":7,"note":"Add nums[2] to the total.","vars":{"size":6,"tsum":11,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,7,3,6,5,6],"pointers":{"i":2},"highlight":[2]}],"moves":[{"from":"nums[2]","to":"tsum"}],"calc":"tsum = 8 + 3 = 11","loop":"i = 2"},{"line":7,"note":"Add nums[3] to the total.","vars":{"size":6,"tsum":17,"i":3},"structures":[{"kind":"array","name":"nums","values":[1,7,3,6,5,6],"pointers":{"i":3},"highlight":[3]}],"moves":[{"from":"nums[3]","to":"tsum"}],"calc":"tsum = 11 + 6 = 17","loo