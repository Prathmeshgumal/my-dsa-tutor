{"id":"799fdef4-d0e4-43e0-baf1-1bb55c7f59aa","title":"Dry run: transpose on [[1,2,3],[4,5,6]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<vector<int>> transpose(vector<vector<int>>& matrix) {\n        int rows = matrix.size();\n        int col = matrix[0].size();\n        vector<vector<int>>result(rows,vector<int>(col));\n\n        for(int i=0;i<rows;i++){\n            for(int j=0;j<col;j++){\n                result[j][i] == matrix[i][j];\n            }\n        }\n\n        return result;\n    }\n};","problem":"transpose-matrix","input":"matrix = [[1,2,3],[4,5,6]]","createdAt":1792603789501,"steps":[{"line":4,"note":"Count the rows of the input.","vars":{"rows":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]}],"calc":"rows = matrix.size() = 2"},{"line":5,"note":"Count the columns of the input.","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]}],"calc":"col = matrix[0].size() = 3"},{"line":6,"note":"result is created as rows × col = 2 × 3, the same shape as the input. The transpose of a 2×3 matrix is 3×2, so this shape is wrong (bug #1).","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"mistake":true,"calc":"result = 2 rows × 3 cols of 0"},{"line":8,"note":"Outer loop starts.","vars":{"rows":2,"col":3,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"check":{"expr":"i < rows → 0 < 2","result":true},"loop":"i = 0"},{"line":9,"note":"Inner loop starts.","vars":{"rows":2,"col":3,"i":0,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"check":{"expr":"j < col → 0 < 3","result":true},"loop":"i = 0 · j = 0"},{"line":10,"note":"`==` is a comparison, not an assignment. It checks 0 == 1, gets false, and throws the result away. result[0][0] stays 0 (bug #2: it should be `=`).","vars":{"rows":2,"col":3,"i":0,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,0]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]],"current":[0,0]}],"mistake":true,"check":{"expr":"result[0][0] == matrix[0][0] → 0 == 1","result":false},"loop":"i = 0 · j = 0"},{"line":10,"note":"Same thing again: a comparison, so nothing is written.","vars":{"rows":2,"col":3,"i":0,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,1]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]],"current":[1,0]}],"check":{"expr":"result[1][0] == matrix[0][1] → 0 == 2","result":false},"loop":"i = 0 · j = 1"},{"line":10,"note":"j = 2 means result[2][0], but result only has rows 0 and 1. That's out of bounds (undefined behaviour). It only didn't crash because `==` reads instead of writes. With `=` this would write to invalid memory. This is bug #1 again.","vars":{"rows":2,"col":3,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,2]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"mistake":true,"check":{"expr":"result[2][0] == matrix[0][2] → row 2 doesn't exist!","result":false},"loop":"i = 0 · j = 2"},{"line":8,"note":"Next row of the input.","vars":{"rows":2,"col":3,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"check":{"expr":"i < rows → 1 < 2","result":true},"loop":"i = 1"},{"line":10,"note":"Still just comparisons (0 == 4, 0 == 5, ...). Nothing changes in result, and j = 2 goes out of bounds again.","vars":{"rows":2,"col":3,"i":1,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[1,0]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]],"current":[0,1]}],"check":{"expr":"result[0][1] == matrix[1][0] → 0 == 4","result":false},"loop":"i = 1 · j = 0..2"},{"line":14,"note":"The loops end and the function returns the untouched 2×3 zero matrix. Expected [[1,4],[2,5],[3,6]].","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0,0],[0,0,0]]}],"output":"[[0,0,0],[0,0,0]]","check":{"expr":"i < rows → 2 < 2","result":false}}]}