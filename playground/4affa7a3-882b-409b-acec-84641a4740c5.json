{"id":"4affa7a3-882b-409b-acec-84641a4740c5","title":"Dry run: pivotIndex on [1,-1,2]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    int pivotIndex(vector<int>& nums) {\n        int size = nums.size();\n        int tsum = 0;\n        for(int i=0;i<size;i++){\n            tsum = tsum+nums[i];\n        }\n\n        int lsum = 0;\n        int rsum = tsum;\n\n        for(int i=0;i<size;i++){\n\n            if(lsum==rsum){\n                return i-1;\n            }\n            lsum = lsum+nums[i-1];\n            rsum = tsum-lsum-nums[i];\n\n        }\n\n        return -1;\n    }\n};","problem":"find-pivot-index","input":"nums = [1,-1,2]","expected":"2","createdAt":1792775735895,"steps":[{"line":4,"note":"Store the array size.","vars":{"size":3},"structures":[{"kind":"array","name":"nums","values":[1,-1,2]}],"calc":"size = 3","phase":"Total sum"},{"line":7,"note":"Add nums[0] to the total.","vars":{"size":3,"tsum":1,"i":0},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":0},"highlight":[0]}],"moves":[{"from":"nums[0]","to":"tsum"}],"calc":"tsum = 0 + 1 = 1","loop":"i = 0"},{"line":7,"note":"Add nums[1] to the total.","vars":{"size":3,"tsum":0,"i":1},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":1},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"tsum"}],"calc":"tsum = 1 + (-1) = 0","loop":"i = 1"},{"line":7,"note":"Add nums[2] to the total.","vars":{"size":3,"tsum":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":2},"highlight":[2]}],"moves":[{"from":"nums[2]","to":"tsum"}],"calc":"tsum = 0 + 2 = 2","loop":"i = 2"},{"line":10,"note":"The left sum starts at 0.","vars":{"size":3,"tsum":2,"lsum":0},"structures":[{"kind":"array","name":"nums","values":[1,-1,2]}],"phase":"Scan for pivot"},{"line":11,"note":"rsum starts as the total sum.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":2},"structures":[{"kind":"array","name":"nums","values":[1,-1,2]}]