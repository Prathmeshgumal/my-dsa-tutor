s","values":[1,-1,2],"pointers":{"i":1},"highlight":[1]}],"calc":"rsum = 2 − 1 − (-1) = 2","loop":"i = 1"},{"line":15,"note":"This checks index 1's sums (left 1, right 2).","vars":{"size":3,"tsum":2,"lsum":1,"rsum":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":2}}],"check":{"expr":"lsum == rsum → 1 == 2","result":false},"loop":"i = 2"},{"line":18,"note":"Add nums[1] to the left sum.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":2,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":2},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"lsum"}],"calc":"lsum = 1 + (-1) = 0","loop":"i = 2"},{"line":19,"note":"These are index 2's sums: left 0 and right 0. Index 2 is the pivot.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,-1,2],"pointers":{"i":2},"highlight":[2]}],"calc":"rsum = 2 − 0 − 2 = 0","loop":"i = 2"},{"line":13,"note":"The loop ends before the check on line 15 runs again. The last index's sums (0 == 0) are never compared.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":0,"i":3},"structures":[{"kind":"array","name":"nums","values":[1,-1,2]}],"mistake":true,"check":{"expr":"i < size → 3 < 3","result":false},"loop":"i = 3"},{"line":23,"note":"The code returns -1, but the correct answer is 2.","vars":{"size":3,"tsum":2,"lsum":0,"rsum":0},"structures":[{"kind":"array","name":"nums","values":[1,-1,2]}],"output":"-1"}]}