{"id":"2132f66f-3f92-4887-9874-8e5cb4783619","title":"Two binary searches: first and last 4 in [1,2,4,4,4,4,4,4,7,9,11]","file":"two-searches.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> searchRange(vector<int>& nums, int target) {\n        int size = nums.size();\n        vector<int> ans = {-1, -1};\n\n        int start = 0;\n        int end = size - 1;\n        while (start <= end) {\n            int mid = start + (end - start) / 2;\n            if (nums[mid] == target) {\n                ans[0] = mid;\n                end = mid - 1;\n            } else if (nums[mid] < target) {\n                start = mid + 1;\n            } else {\n                end = mid - 1;\n            }\n        }\n\n        start = 0;\n        end = size - 1;\n        while (start <= end) {\n            int mid = start + (end - start) / 2;\n            if (nums[mid] == target) {\n                ans[1] = mid;\n                start = mid + 1;\n            } else if (nums[mid] < target) {\n                start = mid + 1;\n            } else {\n                end = mid - 1;\n            }\n        }\n\n        return ans;\n    }\n};\n","problem":"find-first-and-last-position-of-element-in-sorted-array","input":"nums = [1,2,4,4,4,4,4,4,7,9,11], target = 4","expected":"[2,7]","createdAt":1792847651065,"steps":[{"line":5,"note":"ans starts as [-1,-1]. The 4s are at indices 2 to 7.","vars":{"target":4},"structures":[{"kind":"array","name":"nums","values":[1,2,4,4,4,4,4,4,7,9,11]},{"kind":"array","name":"ans","values":[-1,-1]}]},{"line":8,"note":"Full range: start = 0, end = 10.","vars":{"start":0,"end":10},"structures":[{"kind":"array","name":"nums","values":[1,2,4,4,4,4,4,4,7,9,11],"pointers":{"start":0,"end":10}},{"kind":"array","name":"ans","values":[-1,-1]}],"phase":"Search 1: first occurrence (go left on a match)"},{"line":10,"note":"Middle of the range.","vars":{"start":0,"end":10,"mid":5},"structures":[{"kind":"array","name":"nums","values":[1,2,4,4,4,4,4,