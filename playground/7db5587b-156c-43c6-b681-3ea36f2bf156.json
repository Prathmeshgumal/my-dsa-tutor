{"id":"7db5587b-156c-43c6-b681-3ea36f2bf156","title":"Dry run: updated binary search, target 8 (infinite loop)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> searchRange(vector<int>& nums, int target) {\n        int size = nums.size();\n        int start = 0;\n        int end = size-1;\n\n        vector<int>ans={-1,-1};\n\n        while(start<=end){\n            int mid = start+(end-start)/2;\n\n            if(nums[mid] == target){\n                ans[0] = mid;     // where it starts\n                \n\n            }\n\n            else if(nums[mid]<target){\n                start = mid+1;\n            }\n\n            else{\n                end = mid-1;\n            }\n        }\n\n        return ans;\n\n    }\n};","problem":"find-first-and-last-position-of-element-in-sorted-array","input":"nums = [5,7,7,8,8,10], target = 8","expected":"[3,4]","createdAt":1792846361437,"steps":[{"line":6,"note":"Setup: start = 0, end = 5, ans = [-1,-1].","vars":{"start":0,"end":5},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":0,"end":5}},{"kind":"array","name":"ans","values":[-1,-1]}]},{"line":11,"note":"mid = 0 + (5-0)/2 = 2.","vars":{"start":0,"end":5,"mid":2},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":0,"end":5,"mid":2},"highlight":[2]},{"kind":"array","name":"ans","values":[-1,-1]}],"calc":"mid = 0 + 5/2 = 2","loop":"iteration 1","phase":"Search"},{"line":19,"note":"7 < 8, so go right.","vars":{"start":0,"end":5,"mid":2},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":0,"end":5,"mid":2},"highlight":[2]},{"kind":"array","name":"ans","values":[-1,-1]}],"check":{"expr":"nums[2] < 8 → 7 < 8","result":true},"loop":"iteration 1"},{"line":20,"note":"start = mid + 1 = 3.","vars":{"start":3,"end":5,"mid":2},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5}},{"kind":"array","name":"ans","values":[-1,-1]}],"calc":"start = 2 + 1 = 3","loop":"iteration 1"},{"line":11,"note":"mid = 3 + (5-3)/2 = 4.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5,"mid":4},"highlight":[4]},{"kind":"array","name":"ans","values":[-1,-1]}],"calc":"mid = 3 + 2/2 = 4","loop":"iteration 2"},{"line":13,"note":"nums[4] = 8, a match.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5,"mid":4},"highlight":[4]},{"kind":"array","name":"ans","values":[-1,-1]}],"check":{"expr":"nums[4] == 8 → 8 == 8","result":true},"loop":"iteration 2"},{"line":14,"note":"ans[0] = 4. This is not the first 8 (that's index 3), and nothing moves start or end.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5,"mid":4},"highlight":[4]},{"kind":"array","name":"ans","values":[4,-1],"highlight":[0]}],"moves":[{"from":"mid","to":"ans[0]"}],"calc":"ans[0] = mid = 4","loop":"iteration 2"},{"line":10,"note":"start and end are unchanged (3 and 5), so the loop condition is still true.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5}},{"kind":"array","name":"ans","values":[4,-1]}],"check":{"expr":"start <= end → 3 <= 5","result":true},"loop":"iteration 3"},{"line":11,"note":"mid is 4 again, the same state as before.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5,"mid":4},"highlight":[4]},{"kind":"array","name":"ans","values":[4,-1]}],"calc":"mid = 3 + 2/2 = 4","loop":"iteration 3"},{"line":14,"note":"Match again and ans[0] = 4 again. Nothing changes, so this repeats forever (Time Limit Exceeded). Fix: after recording the match, shrink the range with end = mid - 1 to look for an earlier 8. Then ans[0] ends up 3.","vars":{"start":3,"end":5,"mid":4},"structures":[{"kind":"array","name":"nums","values":[5,7,7,8,8,10],"pointers":{"start":3,"end":5,"mid":4},"highlight":[4]},{"kind":"array","name":"ans","values":[4,-1]}],"mistake":true,"loop":"iteration 3, and every one after"}],"formatVersion":1}