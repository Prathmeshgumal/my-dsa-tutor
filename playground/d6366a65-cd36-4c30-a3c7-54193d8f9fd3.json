{"id":"d6366a65-cd36-4c30-a3c7-54193d8f9fd3","title":"Dry run: rotate on [1,2,3,4,5,6,7], k = 3 (with j-2)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-1;i>size-1-shift;i--){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>size-1-shift;j--){\n            nums[j] = nums[j-2];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5,6,7], k = 3","createdAt":1792512403918,"steps":[{"line":5,"note":"size = 7, shift = 3 % 7 = 3.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"shift = 3 % 7 = 3"},{"line":9,"note":"Save loop runs for i = 6, 5, 4, giving temp = [7, 6, 5]. Still reversed.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"highlight":[4,5,6]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[6]","to":"temp[0]"},{"from":"nums[5]","to":"temp[1]"},{"from":"nums[4]","to":"temp[2]"}],"loop":"save loop done"},{"line":12,"note":"Shift loop: j starts at 6 and runs while j > 3. That's still only 3 iterations, but 4 elements (1,2,3,4) need to move.","vars":{"size":7,"shift":3,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"j":6}},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"check":{"expr":"6 > 3","result":true},"loop":"shift loop · j = 6"},{"line":13,"note":"nums[6] = nums[6-2] = nums[4] = 5. The 2 is hard-coded, so it only works when shift = 2. Here shift = 3, so nums[6] should get nums[3] = 4.","vars":{"size":7,"shift":3,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,5],"pointers":{"j":6},"highlight":[4]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"mistake":true,"moves":[{"from":"nums[4]","to":"nums[6]"}],"calc":"nums[6] = nums[4] = 5","loop":"shift loop · j = 6"},{"line":13,"note":"j = 5: nums[5] = nums[3] = 4.","vars":{"size":7,"shift":3,"j":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,4,5],"pointers":{"j":5},"highlight":[3]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[3]","to":"nums[5]"}],"check":{"expr":"5 > 3","result":true},"calc":"nums[5] = nums[3] = 4","loop":"shift loop · j = 5"},{"line":13,"note":"j = 4: nums[4] = nums[2] = 3.","vars":{"size":7,"shift":3,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,3,4,5],"pointers":{"j":4},"highlight":[2]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[2]","to":"nums[4]"}],"check":{"expr":"4 > 3","result":true},"calc":"nums[4] = nums[2] = 3","loop":"shift loop · j = 4"},{"line":12,"note":"j = 3 fails 3 > 3, so the loop stops. Index 3 never receives nums[0] = 1, and 1 and 2 are lost. The loop should keep going down to j = shift (here 3).","vars":{"size":7,"shift":3,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,3,4,5],"pointers":{"j":3}},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"mistake":true,"check":{"expr":"3 > 3","result":false},"loop":"shift loop · j = 3"},{"line":17,"note":"The copy-back loop writes temp[0..2] = 7, 6, 5 into nums[0..2]. Because temp is reversed, the front is 7,6,5 instead of 5,6,7.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[7,6,5,4,3,4,5],"highlight":[0,1,2]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"mistake":true,"moves":[{"from":"temp[0]","to":"nums[0]"},{"from":"temp[1]","to":"nums[1]"},{"from":"temp[2]","to":"nums[2]"}],"loop":"copy loop · k = 0..2"},{"line":19,"note":"Result [7,6,5,4,3,4,5], expected [5,6,7,1,2,3,4].","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[7,6,5,4,3,4,5]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}]}]}