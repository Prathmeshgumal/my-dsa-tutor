op":"i = 1"},{"line":19,"note":"nums[2] leaves the right side.","vars":{"size":3,"tsum":6,"lsum":3,"rsum":0,"i":1},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":1},"highlight":[2]}],"calc":"rsum = 3 − 3 = 0","loop":"i = 1"},{"line":13,"note":"Move on to index 2, the last one.","vars":{"size":3,"tsum":6,"lsum":3,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":2}}],"check":{"expr":"i < size → 2 < 3","result":true},"loop":"i = 2"},{"line":15,"note":"Is index 2 the pivot? Left 1 + 2 = 3, right 0. The last index does get checked now.","vars":{"size":3,"tsum":6,"lsum":3,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":2}}],"check":{"expr":"lsum == rsum → 3 == 0","result":false},"loop":"i = 2"},{"line":18,"note":"nums[2] moves to the left side.","vars":{"size":3,"tsum":6,"lsum":6,"rsum":0,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":2},"highlight":[2]}],"moves":[{"from":"nums[2]","to":"lsum"}],"calc":"lsum = 3 + 3 = 6","loop":"i = 2"},{"line":19,"note":"When i = 2, i + 1 = 3, so this reads nums[3], which is past the end of the array (undefined behaviour). The value is never used because the loop ends next, so the answer is still right, but the read itself is a bug.","vars":{"size":3,"tsum":6,"lsum":6,"rsum":"???","i":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":2}}],"mistake":true,"calc":"rsum = 0 − nums[3] = 0 − ???","loop":"i = 2"},{"line":13,"note":"i reaches size, so the loop ends.","vars":{"size":3,"tsum":6,"lsum":6,"rsum":"???","i":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3]}],"check":{"expr":"i < size → 3 < 3","result":false},"loop":"i = 3"},{"line":23,"note":"No index had equal sums, so the code returns -1. That's correct.","vars":{"size":3,"tsum":6,"lsum":6,"rsum":"???"},"structures":[{"kind":"array","name":"nums","values":[1,2,3]}],"output":"-1"}]}