{"id":"ca3a4e2a-a9f3-4ad2-a3d4-7fb34738634b","title":"Dry run: pivotIndex on [1,2,3]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    int pivotIndex(vector<int>& nums) {\n        int size = nums.size();\n        int tsum = 0;\n        for(int i=0;i<size;i++){\n            tsum = tsum+nums[i];\n        }\n\n        int lsum = 0;\n        int rsum = tsum-nums[0];\n\n        for(int i=0;i<size;i++){\n\n            if(lsum==rsum){\n                return i;\n            }\n            lsum = lsum+nums[i];\n            rsum = rsum-nums[i+1];\n\n        }\n\n        return -1;\n    }\n};","problem":"find-pivot-index","input":"nums = [1,2,3]","expected":"-1","createdAt":1792776288475,"steps":[{"line":4,"note":"Store the array size.","vars":{"size":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3]}],"calc":"size = 3","phase":"Total sum"},{"line":7,"note":"Add nums[0] to the total.","vars":{"size":3,"tsum":1,"i":0},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":0},"highlight":[0]}],"moves":[{"from":"nums[0]","to":"tsum"}],"calc":"tsum = 0 + 1 = 1","loop":"i = 0"},{"line":7,"note":"Add nums[1] to the total.","vars":{"size":3,"tsum":3,"i":1},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":1},"highlight":[1]}],"moves":[{"from":"nums[1]","to":"tsum"}],"calc":"tsum = 1 + 2 = 3","loop":"i = 1"},{"line":7,"note":"Add nums[2] to the total.","vars":{"size":3,"tsum":6,"i":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3],"pointers":{"i":2},"highlight":[2]}],"moves":[{"from":"nums[2]","to":"tsum"}],"calc":"tsum = 3 + 3 = 6","loop":"i = 2"},{"line":10,"note":"Index 0 has nothing to its left, so lsum starts at 0.","vars":{"size":3,"tsum":6,"lsum":0},"structures":[{"kind":"array","name":"nums","values":[1,2,3]}],"phase":"Scan for pivot"},{"line":11,"note":"The right sum of index 0 is everything except nums[0], so lsum and rsum now belong to index 0 from the start.","vars":{