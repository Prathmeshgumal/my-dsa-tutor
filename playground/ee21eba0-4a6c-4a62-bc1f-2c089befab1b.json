{"id":"ee21eba0-4a6c-4a62-bc1f-2c089befab1b","title":"Dry run: shiftRight on [-1,-2,0,3,8,9]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> shiftRight(vector<int>& arr) {\n        int size = arr.size();\n        if(size ==0){\n            return arr;\n        }\n        \n        else{\n            int end = arr[size-1];\n            for(int i=size-1;i>0;i--){\n            arr[i] = arr[i-1];\n        }\n        arr[0] = end;\n        }\n        return arr;\n    }\n};","problem":"shift-array-elements-by-one-position","input":"arr = [-1,-2,0,3,8,9]","createdAt":1792511227855,"steps":[{"line":4,"note":"Store the array's length.","vars":{"size":6},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,9]}],"calc":"size = arr.size() = 6"},{"line":5,"note":"The array isn't empty, so we go into the else branch.","vars":{"size":6},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,9]}],"check":{"expr":"size == 0 → 6 == 0","result":false}},{"line":10,"note":"Save the last element (9). It will wrap around to the front.","vars":{"size":6,"end":9},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,9],"highlight":[5]}],"moves":[{"from":"arr[5]","to":"end","label":"save"}],"calc":"end = arr[5] = 9"},{"line":11,"note":"Start from the back: i = 5.","vars":{"size":6,"end":9,"i":5},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,9],"pointers":{"i":5}}],"check":{"expr":"i > 0 → 5 > 0","result":true},"loop":"i = 5"},{"line":12,"note":"8 moves into slot 5. The 9 that was there is safe in end.","vars":{"size":6,"end":9,"i":5},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,8],"pointers":{"i":5},"highlight":[4,5]}],"moves":[{"from":"arr[4]","to":"arr[5]"}],"calc":"arr[5] = arr[4] = 8","loop":"i = 5"},{"line":11,"note":"i-- → 4.","vars":{"size":6,"end":9,"i":4},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,8,8],"pointers":{"i":4}}],"check":{"expr":"i > 0 → 4 > 0","result":true},"loop":"i = 4"},{"line":12,"note":"3 moves into slot 4.","vars":{"size":6,"end":9,"i":4},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,3,8],"pointers":{"i":4},"highlight":[3,4]}],"moves":[{"from":"arr[3]","to":"arr[4]"}],"calc":"arr[4] = arr[3] = 3","loop":"i = 4"},{"line":11,"note":"i-- → 3.","vars":{"size":6,"end":9,"i":3},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,3,3,8],"pointers":{"i":3}}],"check":{"expr":"i > 0 → 3 > 0","result":true},"loop":"i = 3"},{"line":12,"note":"0 moves into slot 3.","vars":{"size":6,"end":9,"i":3},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,0,3,8],"pointers":{"i":3},"highlight":[2,3]}],"moves":[{"from":"arr[2]","to":"arr[3]"}],"calc":"arr[3] = arr[2] = 0","loop":"i = 3"},{"line":11,"note":"i-- → 2.","vars":{"size":6,"end":9,"i":2},"structures":[{"kind":"array","name":"arr","values":[-1,-2,0,0,3,8],"pointers":{"i":2}}],"check":{"expr":"i > 0 → 2 > 0","result":true},"loop":"i = 2"},{"line":12,"note":"-2 moves into slot 2. Negative numbers are copied like any other value.","vars":{"size":6,"end":9,"i":2},"structures":[{"kind":"array","name":"arr","values":[-1,-2,-2,0,3,8],"pointers":{"i":2},"highlight":[1,2]}],"moves":[{"from":"arr[1]","to":"arr[2]"}],"calc":"arr[2] = arr[1] = -2","loop":"i = 2"},{"line":11,"note":"i-- → 1.","vars":{"size":6,"end":9,"i":1},"structures":[{"kind":"array","name":"arr","values":[-1,-2,-2,0,3,8],"pointers":{"i":1}}],"check":{"expr":"i > 0 → 1 > 0","result":true},"loop":"i = 1"},{"line":12,"note":"-1 moves into slot 1.","vars":{"size":6,"end":9,"i":1},"structures":[{"kind":"array","name":"arr","values":[-1,-1,-2,0,3,8],"pointers":{"i":1},"highlight":[0,1]}],"moves":[{"from":"arr[0]","to":"arr[1]"}],"calc":"arr[1] = arr[0] = -1","loop":"i = 1"},{"line":11,"note":"i-- → 0. The loop stops.","vars":{"size":6,"end":9,"i":0},"structures":[{"kind":"array","name":"arr","values":[-1,-1,-2,0,3,8],"pointers":{"i":0}}],"check":{"expr":"i > 0 → 0 > 0","result":false},"loop":"i = 0"},{"line":14,"note":"The saved 9 wraps around to the front.","vars":{"size":6,"end":9},"structures":[{"kind":"array","name":"arr","values":[9,-1,-2,0,3,8],"highlight":[0],"done":[0,1,2,3,4,5]}],"moves":[{"from":"end","to":"arr[0]","label":"wrap"}],"calc":"arr[0] = end = 9"},{"line":16,"note":"Return [9,-1,-2,0,3,8] ✅","vars":{"size":6,"end":9},"structures":[{"kind":"array","name":"arr","values":[9,-1,-2,0,3,8],"done":[0,1,2,3,4,5]}],"output":"[9,-1,-2,0,3,8]"}]}