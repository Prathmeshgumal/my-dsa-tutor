{"id":"ab380102-29ef-4144-887e-4baf6ba88127","title":"Dry run: spiralOrder on [[1,2,3],[4,5,6],[7,8,9]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> spiralOrder(vector<vector<int>>& matrix) {\n        int size = matrix.size();\n        int top = 0;\n        int right = size-1;\n        int bottom = size-1;\n        int left = 0;\n        vector<int>ans;\n\n        for(int i=0;i<right;i++){\n            for(int j=0;j<right;j++){\n                ans.push_back(matrix[i][j]);\n            }\n        }\n        \n    }\n};","problem":"spiral-matrix","input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792605780576,"steps":[{"line":4,"note":"Get the number of rows. For a non-square matrix you'll also need the column count, matrix[0].size().","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"size = 3"},{"line":5,"note":"top = 0: the first row.","vars":{"size":3,"top":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}]},{"line":6,"note":"right = the last column index.","vars":{"size":3,"top":0,"right":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"right = 3 - 1 = 2"},{"line":7,"note":"bottom = the last row index.","vars":{"size":3,"top":0,"right":2,"bottom":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"bottom = 3 - 1 = 2"},{"line":8,"note":"left = 0. These four boundaries are exactly right for this problem.","vars":{"size":3,"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}]},{"line":11,"note":"The outer loop goes over rows i = 0, 1, ... It never uses top, bottom or left.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"check":{"expr":"i < right → 0 < 2","result":true},"loop":"i = 0"},{"line":13,"note":"Push matrix[0][0] = 1.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]},{"kind":"array","name":"ans","values":[1]}],"moves":[{"from":"matrix[0][0]","to":"ans[0]"}],"loop":"i = 0 · j = 0"},{"line":13,"note":"Push matrix[0][1] = 2.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1]},{"kind":"array","name":"ans","values":[1,2]}],"moves":[{"from":"matrix[0][1]","to":"ans[1]"}],"loop":"i = 0 · j = 1"},{"line":12,"note":"j < right stops before j = 2, so 3 (the last column) is skipped. The top row needs to run from left to right inclusive: j <= right.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[0,2]]},{"kind":"array","name":"ans","values":[1,2]}],"mistake":true,"check":{"expr":"j < right → 2 < 2","result":false},"loop":"i = 0 · j = 2"},{"line":11,"note":"This is where it stops being a spiral: it moves on to row 1. A spiral would now go DOWN the right column (6, 9), then left along the bottom row, then up the left column.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2]}],"mistake":true,"check":{"expr":"i < right → 1 < 2","result":true},"loop":"i = 1"},{"line":13,"note":"Push matrix[1][0] = 4.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,0]},{"kind":"array","name":"ans","values":[1,2,4]}],"moves":[{"from":"matrix[1][0]","to":"ans[2]"}],"loop":"i = 1 · j = 0"},{"line":13,"note":"Push matrix[1][1] = 5.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1]},{"kind":"array","name":"ans","values":[1,2,4,5]}],"moves":[{"from":"matrix[1][1]","to":"ans[3]"}],"loop":"i = 1 · j = 1"},{"line":11,"note":"The outer loop ends, so row 2 is never visited. What you have now is a row-by-row walk over a 2×2 corner, not a spiral.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,4,5]}],"check":{"expr":"i < right → 2 < 2","result":false},"loop":"i = 2"},{"line":17,"note":"The function ends without `return ans;`. In C++ that is undefined behaviour, and it's why the test run crashes with a segmentation fault (exit 139).","vars":{"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,4,5]}],"mistake":true}]}