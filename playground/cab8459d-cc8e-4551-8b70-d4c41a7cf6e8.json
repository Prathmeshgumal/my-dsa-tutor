{"id":"cab8459d-cc8e-4551-8b70-d4c41a7cf6e8","title":"Dry run: spiralOrder on [[1,2,3],[4,5,6],[7,8,9]] (while with <=)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> spiralOrder(vector<vector<int>>& matrix) {\n        int size = matrix.size();\n        int top = 0;\n        int right = size-1;\n        int bottom = size-1;\n        int left = 0;\n        vector<int>ans;\n\n        while(left<=right && top<=bottom){\n            // move right\n            for(int i=top;i<=right;i++){\n                ans.push_back(matrix[top][i]);\n            }\n            top++;\n\n            // move down\n            for(int i=top;i<=bottom;i++){\n                ans.push_back(matrix[i][right]);\n            }\n            right--;\n\n            // move left\n            for(int i=right;i>=left;i--){\n                ans.push_back(matrix[bottom][i]);\n            }\n            bottom--;\n\n            // move up\n            for(int i=bottom;i>=top;i--){\n                ans.push_back(matrix[i][left]);\n            }\n            left++;\n        }\n\n        return ans;\n        \n    }\n};","problem":"spiral-matrix","input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792607137076,"steps":[{"line":4,"note":"size = number of rows = 3.","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"size = matrix.size() = 3"},{"line":8,"note":"Set up the four boundaries. right uses the row count, which is fine here since the matrix is 3×3.","vars":{"size":3,"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"top=0, right=2, bottom=2, left=0"},{"line":11,"note":"Start lap 1 (the outer ring).","vars":{"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"check":{"expr":"left<=right && top<=bottom → 0<=2 && 0<=2","result":true},"loop":"lap 1"},{"line":14,"note":"Top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]},{"kind":"array","name":"ans","values":[1],"highlight":[0]}],"moves":[{"from":"matrix[0][0]","to":"ans[0]"}],"calc":"push matrix[0][0] = 1","loop":"lap 1 · move right · i = 0"},{"line":14,"note":"Top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1]},{"kind":"array","name":"ans","values":[1,2],"highlight":[1]}],"moves":[{"from":"matrix[0][1]","to":"ans[1]"}],"calc":"push matrix[0][1] = 2","loop":"lap 1 · move right · i = 1"},{"line":14,"note":"Top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2]},{"kind":"array","name":"ans","values":[1,2,3],"highlight":[2]}],"moves":[{"from":"matrix[0][2]","to":"ans[2]"}],"calc":"push matrix[0][2] = 3","loop":"lap 1 · move right · i = 2"},{"line":16,"note":"Shrink top.","vars":{"top":1,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3]}],"calc":"top = 0 + 1 = 1","loop":"lap 1"},{"line":20,"note":"Right column.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,2]},{"kind":"array","name":"ans","values":[1,2,3,6],"highlight":[3]}],"moves":[{"from":"matrix[1][2]","to":"ans[3]"}],"calc":"push matrix[1][2] = 6","loop":"lap 1 · move down · i = 1"},{"line":20,"note":"Right column.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2]},{"kind":"array","name":"ans","values":[1,2,3,6,9],"highlight":[4]}],"moves":[{"from":"matrix[2][2]","to":"ans[4]"}],"calc":"push matrix[2][2] = 9","loop":"lap 1 · move down · i = 2"},{"line":22,"note":"Shrink right.","vars":{"top":1,"right":1,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9]}],"calc":"right = 2 - 1 = 1","loop":"lap 1"},{"line":26,"note":"Bottom row.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,1]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8],"highlight":[5]}],"moves":[{"from":"matrix[2][1]","to":"ans[5]"}],"calc":"push matrix[2][1] = 8","loop":"lap 1 · move left · i = 1"},{"line":26,"note":"Bottom row.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7],"highlight":[6]}],"moves":[{"from":"matrix[2][0]","to":"ans[6]"}],"calc":"push matrix[2][0] = 7","loop":"lap 1 · move left · i = 0"},{"line":28,"note":"Shrink bottom.","vars":{"top":1,"right":1,"bottom":1,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7]}],"calc":"bottom = 2 - 1 = 1","loop":"lap 1"},{"line":32,"note":"Left column.","vars":{"top":1,"right":1,"bottom":1,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,0]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4],"highlight":[7]}],"moves":[{"from":"matrix[1][0]","to":"ans[7]"}],"calc":"push matrix[1][0] = 4","loop":"lap 1 · move up · i = 1"},{"line":34,"note":"Shrink left. The boundaries now all point at the middle cell.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4]}],"calc":"left = 0 + 1 = 1","loop":"lap 1"},{"line":11,"note":"Fixed: with <= the loop goes round again for the single middle cell.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4]}],"check":{"expr":"left<=right && top<=bottom → 1<=1 && 1<=1","result":true},"loop":"lap 2"},{"line":14,"note":"The 'top row' of this ring is just the middle cell.","vars":{"top":1,"right":1,"bottom":1,"left":1,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5],"highlight":[8]}],"moves":[{"from":"matrix[1][1]","to":"ans[8]"}],"calc":"push matrix[1][1] = 5","loop":"lap 2 · move right · i = 1"},{"line":16,"note":"Shrink top.","vars":{"top":2,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"calc":"top = 1 + 1 = 2","loop":"lap 2"},{"line":19,"note":"Nothing to walk down, so the loop body is skipped.","vars":{"top":2,"right":1,"bottom":1,"left":1,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"check":{"expr":"i <= bottom → 2 <= 1","result":false},"loop":"lap 2 · move down"},{"line":22,"note":"Shrink right.","vars":{"top":2,"right":0,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"calc":"right = 1 - 1 = 0","loop":"lap 2"},{"line":25,"note":"Skipped. In this case it happens to be safe, because right already went below left.","vars":{"top":2,"right":0,"bottom":1,"left":1,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"check":{"expr":"i >= left → 0 >= 1","result":false},"loop":"lap 2 · move left"},{"line":28,"note":"Shrink bottom.","vars":{"top":2,"right":0,"bottom":0,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"calc":"bottom = 1 - 1 = 0","loop":"lap 2"},{"line":31,"note":"Skipped.","vars":{"top":2,"right":0,"bottom":0,"left":1,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"check":{"expr":"i >= top → 0 >= 2","result":false},"loop":"lap 2 · move up"},{"line":34,"note":"Shrink left.","vars":{"top":2,"right":0,"bottom":0,"left":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"calc":"left = 1 + 1 = 2","loop":"lap 2"},{"line":11,"note":"No cells left, so the loop ends.","vars":{"top":2,"right":0,"bottom":0,"left":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5]}],"check":{"expr":"left<=right && top<=bottom → 2<=0 && 2<=0","result":false},"loop":"lap 3?"},{"line":37,"note":"Returns [1,2,3,6,9,8,7,4,5], which matches the expected output.","vars":{"top":2,"right":0,"bottom":0,"left":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4,5],"done":[0,1,2,3,4,5,6,7,8]}]}]}