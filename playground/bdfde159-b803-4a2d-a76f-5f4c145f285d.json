{"id":"bdfde159-b803-4a2d-a76f-5f4c145f285d","title":"Dry run: diagonalSum on [[1,2,3],[4,5,6],[7,8,9]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    int diagonalSum(vector<vector<int>>& mat) {\n        int size = mat.size();\n        int sum = 0;\n        for(int i=0;i<size;i++){\n            for(int j=0;j<size;j++){\n                if(i == j or i+j == size-1){\n                    sum = sum + mat[i][j];\n                }\n            }\n        }\n        return sum;\n    }\n};","problem":"matrix-diagonal-sum","input":"mat = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792601679234,"steps":[{"line":4,"note":"Get the size of the square matrix.","vars":{"size":3},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]]}],"calc":"size = mat.size() = 3"},{"line":5,"note":"Start the running total at 0.","vars":{"size":3,"sum":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]]}]},{"line":8,"note":"(0,0): i == j, so it's on the primary diagonal.","vars":{"size":3,"sum":0,"i":0,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]}],"check":{"expr":"0 == 0 or 0+0 == 2","result":true},"loop":"i = 0 · j = 0"},{"line":9,"note":"Add mat[0][0].","vars":{"size":3,"sum":1,"i":0,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]}],"calc":"sum = 0 + 1 = 1","loop":"i = 0 · j = 0"},{"line":8,"note":"(0,1) is on neither diagonal, so skip it.","vars":{"size":3,"sum":1,"i":0,"j":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1],"highlight":[[0,0]]}],"check":{"expr":"0 == 1 or 0+1 == 2","result":false},"loop":"i = 0 · j = 1"},{"line":8,"note":"(0,2): i + j == size-1, so it's on the secondary diagonal.","vars":{"size":3,"sum":1,"i":0,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2],"highlight":[[0,0]]}],"check":{"expr":"0 == 2 or 0+2 == 2","result":true},"loop":"i = 0 · j = 2"},{"line":9,"note":"Add mat[0][2].","vars":{"size":3,"sum":4,"i":0,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2],"highlight":[[0,0]]}],"calc":"sum = 1 + 3 = 4","loop":"i = 0 · j = 2"},{"line":8,"note":"(1,0) is on neither diagonal, so skip it.","vars":{"size":3,"sum":4,"i":1,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,0],"highlight":[[0,0],[0,2]]}],"check":{"expr":"1 == 0 or 1+0 == 2","result":false},"loop":"i = 1 · j = 0"},{"line":8,"note":"(1,1), the center, is on BOTH diagonals. The `or` makes the condition true once, so it is added only once. This is the tricky part of the problem.","vars":{"size":3,"sum":4,"i":1,"j":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0],[0,2]]}],"check":{"expr":"1 == 1 or 1+1 == 2","result":true},"loop":"i = 1 · j = 1"},{"line":9,"note":"Add mat[1][1], only once.","vars":{"size":3,"sum":9,"i":1,"j":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,1],"highlight":[[0,0],[0,2]]}],"calc":"sum = 4 + 5 = 9","loop":"i = 1 · j = 1"},{"line":8,"note":"(1,2) is on neither diagonal, so skip it.","vars":{"size":3,"sum":9,"i":1,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,2],"highlight":[[0,0],[0,2],[1,1]]}],"check":{"expr":"1 == 2 or 1+2 == 2","result":false},"loop":"i = 1 · j = 2"},{"line":8,"note":"(2,0): i + j == 2, so it's on the secondary diagonal.","vars":{"size":3,"sum":9,"i":2,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0],"highlight":[[0,0],[0,2],[1,1]]}],"check":{"expr":"2 == 0 or 2+0 == 2","result":true},"loop":"i = 2 · j = 0"},{"line":9,"note":"Add mat[2][0].","vars":{"size":3,"sum":16,"i":2,"j":0},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0],"highlight":[[0,0],[0,2],[1,1]]}],"calc":"sum = 9 + 7 = 16","loop":"i = 2 · j = 0"},{"line":8,"note":"(2,1) is on neither diagonal, so skip it.","vars":{"size":3,"sum":16,"i":2,"j":1},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,1],"highlight":[[0,0],[0,2],[1,1],[2,0]]}],"check":{"expr":"2 == 1 or 2+1 == 2","result":false},"loop":"i = 2 · j = 1"},{"line":8,"note":"(2,2): i == j, so it's on the primary diagonal.","vars":{"size":3,"sum":16,"i":2,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2],"highlight":[[0,0],[0,2],[1,1],[2,0]]}],"check":{"expr":"2 == 2 or 2+2 == 2","result":true},"loop":"i = 2 · j = 2"},{"line":9,"note":"Add mat[2][2].","vars":{"size":3,"sum":25,"i":2,"j":2},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2],"highlight":[[0,0],[0,2],[1,1],[2,0]]}],"calc":"sum = 16 + 9 = 25","loop":"i = 2 · j = 2"},{"line":13,"note":"Both loops are done. Return 25 (1 + 3 + 5 + 7 + 9), which matches the expected answer. All 9 cells were checked to find the 5 diagonal ones.","vars":{"size":3,"sum":25},"structures":[{"kind":"grid","name":"mat","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[0,0],[0,2],[1,1],[2,0],[2,2]]}]}]}