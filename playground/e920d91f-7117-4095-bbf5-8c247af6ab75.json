{"id":"e920d91f-7117-4095-bbf5-8c247af6ab75","title":"Dry run: rotate on [1,2,3,4,5,6,7], k = 3 (with j-shift)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-1;i>size-1-shift;i--){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>size-1-shift;j--){\n            nums[j] = nums[j-shift];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5,6,7], k = 3","createdAt":1792512471593,"steps":[{"line":5,"note":"size = 7, shift = 3.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"shift = 3 % 7 = 3"},{"line":9,"note":"The save loop gives temp = [7, 6, 5]. It's still reversed.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"highlight":[4,5,6]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[6]","to":"temp[0]"},{"from":"nums[5]","to":"temp[1]"},{"from":"nums[4]","to":"temp[2]"}],"loop":"save loop done"},{"line":13,"note":"j = 6: nums[6] = nums[6-3] = nums[3] = 4. Correct now: the element moves by exactly shift places.","vars":{"size":7,"shift":3,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,4],"pointers":{"j":6},"highlight":[3]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[3]","to":"nums[6]"}],"check":{"expr":"6 > 3","result":true},"calc":"nums[6] = nums[3] = 4","loop":"shift loop · j = 6"},{"line":13,"note":"j = 5: nums[5] = nums[2] = 3. Correct.","vars":{"size":7,"shift":3,"j":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,3,4],"pointers":{"j":5},"highlight":[2]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[2]","to":"nums[5]"}],"check":{"expr":"5 > 3","result":true},"calc":"nums[5] = nums[2] = 3","loop":"shift loop · j = 5"},{"line":13,"note":"j = 4: nums[4] = nums[1] = 2. Correct.","vars":{"size":7,"shift":3,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,2,3,4],"pointers":{"j":4},"highlight":[1]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"moves":[{"from":"nums[1]","to":"nums[4]"}],"check":{"expr":"4 > 3","result":true},"calc":"nums[4] = nums[1] = 2","loop":"shift loop · j = 4"},{"line":12,"note":"j = 3: 3 > 3 is false, so the loop stops one step early. It should still do nums[3] = nums[0] = 1. The condition needs to be j >= shift.","vars":{"size":7,"shift":3,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,2,3,4],"pointers":{"j":3},"highlight":[0]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"mistake":true,"check":{"expr":"3 > 3","result":false},"loop":"shift loop · j = 3"},{"line":17,"note":"The copy-back loop writes 7, 6, 5 into nums[0..2], but the answer needs 5, 6, 7. temp is reversed, so read temp[shift-1-k].","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[7,6,5,4,2,3,4],"highlight":[0,1,2]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}],"mistake":true,"moves":[{"from":"temp[0]","to":"nums[0]"},{"from":"temp[1]","to":"nums[1]"},{"from":"temp[2]","to":"nums[2]"}],"loop":"copy loop · k = 0..2"},{"line":19,"note":"Result [7,6,5,4,2,3,4], expected [5,6,7,1,2,3,4]. The last three (2,3,4) are already right.","vars":{"size":7,"shift":3},"structures":[{"kind":"array","name":"nums","values":[7,6,5,4,2,3,4]},{"kind":"array","name":"temp","values":[7,6,5],"capacity":4}]}]}