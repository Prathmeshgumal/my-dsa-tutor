{"id":"f5179dac-bc1a-4b8b-b52d-8f6285ac2468","title":"Dry run: spiralOrder on [[1,2,3],[4,5,6],[7,8,9]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> spiralOrder(vector<vector<int>>& matrix) {\n        int size = matrix.size();\n        int top = 0;\n        int right = size-1;\n        int bottom = size-1;\n        int left = 0;\n        vector<int>ans;\n\n        // move right\n        for(int i=top;i<=right;i++){\n            ans.push_back(matrix[top][i]);\n        }\n        top++;\n\n        // move down\n        for(int i=top;i<=bottom;i++){\n            ans.push_back(matrix[i][right]);\n        }\n        right--;\n\n        // move left\n        for(int i=right;i>=left;i--){\n            ans.push_back(matrix[bottom][i]);\n        }\n        bottom--;\n\n        // move up\n        for(int i=bottom;i>=top;i--){\n            ans.push_back(matrix[left][i]);\n        }\n        left++;\n\n        return ans;\n        \n    }\n};","problem":"spiral-matrix","input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792606672675,"steps":[{"line":4,"note":"size = number of rows = 3.","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"size = matrix.size() = 3"},{"line":8,"note":"Set up the four boundaries. Note: right uses the ROW count. That's fine for a square matrix but wrong when rows ≠ cols.","vars":{"size":3,"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"top=0, right=2, bottom=2, left=0"},{"line":13,"note":"Walk the top row left→right.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]},{"kind":"array","name":"ans","values":[1],"highlight":[0]}],"moves":[{"from":"matrix[0][0]","to":"ans[0]"}],"calc":"push matrix[0][0] = 1","loop":"move right · i = 0"},{"line":13,"note":"Next on the top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1]},{"kind":"array","name":"ans","values":[1,2],"highlight":[1]}],"moves":[{"from":"matrix[0][1]","to":"ans[1]"}],"calc":"push matrix[0][1] = 2","loop":"move right · i = 1"},{"line":13,"note":"Last on the top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2]},{"kind":"array","name":"ans","values":[1,2,3],"highlight":[2]}],"moves":[{"from":"matrix[0][2]","to":"ans[2]"}],"calc":"push matrix[0][2] = 3","loop":"move right · i = 2"},{"line":15,"note":"Top row done, shrink top.","vars":{"top":1,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3]}],"calc":"top = 0 + 1 = 1"},{"line":19,"note":"Walk the right column top→bottom.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,2]},{"kind":"array","name":"ans","values":[1,2,3,6],"highlight":[3]}],"moves":[{"from":"matrix[1][2]","to":"ans[3]"}],"calc":"push matrix[1][2] = 6","loop":"move down · i = 1"},{"line":19,"note":"Bottom of right column.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2]},{"kind":"array","name":"ans","values":[1,2,3,6,9],"highlight":[4]}],"moves":[{"from":"matrix[2][2]","to":"ans[4]"}],"calc":"push matrix[2][2] = 9","loop":"move down · i = 2"},{"line":21,"note":"Right column done, shrink right.","vars":{"top":1,"right":1,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9]}],"calc":"right = 2 - 1 = 1"},{"line":25,"note":"Walk the bottom row right→left.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,1]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8],"highlight":[5]}],"moves":[{"from":"matrix[2][1]","to":"ans[5]"}],"calc":"push matrix[2][1] = 8","loop":"move left · i = 1"},{"line":25,"note":"End of bottom row.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7],"highlight":[6]}],"moves":[{"from":"matrix[2][0]","to":"ans[6]"}],"calc":"push matrix[2][0] = 7","loop":"move left · i = 0"},{"line":27,"note":"Bottom row done, shrink bottom.","vars":{"top":1,"right":1,"bottom":1,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7]}],"calc":"bottom = 2 - 1 = 1"},{"line":30,"note":"Walk the left column bottom→top. Only row 1 is left.","vars":{"top":1,"right":1,"bottom":1,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7]}],"check":{"expr":"i >= top → 1 >= 1","result":true},"loop":"move up · i = 1"},{"line":31,"note":"BUG: the indices are swapped. matrix[left][i] = matrix[0][1] = 2, which was already used! Moving up a column changes the ROW, so this should be matrix[i][left] = matrix[1][0] = 4.","vars":{"top":1,"right":1,"bottom":1,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1],"highlight":[[1,0]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,2],"highlight":[7]}],"mistake":true,"moves":[{"from":"matrix[0][1]","to":"ans[7]"}],"calc":"push matrix[0][1] = 2  (should be matrix[1][0] = 4)","loop":"move up · i = 1"},{"line":33,"note":"Left column done, shrink left. But there's no outer loop, so the inner layer (5) is never visited.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,2]}],"calc":"left = 0 + 1 = 1"},{"line":35,"note":"BUG: the function ends without `return ans;`. Running off the end of a non-void function is undefined behaviour. That causes the segfault (exit 139) in the tests.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,2]}],"mistake":true}]}