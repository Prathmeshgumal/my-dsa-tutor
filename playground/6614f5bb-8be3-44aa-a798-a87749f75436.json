{"id":"6614f5bb-8be3-44aa-a798-a87749f75436","title":"Dry run: spiralOrder on [[1,2,3],[4,5,6],[7,8,9]] (with while loop)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> spiralOrder(vector<vector<int>>& matrix) {\n        int size = matrix.size();\n        int top = 0;\n        int right = size-1;\n        int bottom = size-1;\n        int left = 0;\n        vector<int>ans;\n\n        while(left<right && top<bottom){\n            // move right\n            for(int i=top;i<=right;i++){\n                ans.push_back(matrix[top][i]);\n            }\n            top++;\n\n            // move down\n            for(int i=top;i<=bottom;i++){\n                ans.push_back(matrix[i][right]);\n            }\n            right--;\n\n            // move left\n            for(int i=right;i>=left;i--){\n                ans.push_back(matrix[bottom][i]);\n            }\n            bottom--;\n\n            // move up\n            for(int i=bottom;i>=top;i--){\n                ans.push_back(matrix[i][left]);\n            }\n            left++;\n        }\n\n        return ans;\n        \n    }\n};","problem":"spiral-matrix","input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","createdAt":1792607047164,"steps":[{"line":4,"note":"size = number of rows = 3.","vars":{"size":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"size = matrix.size() = 3"},{"line":8,"note":"Set up the four boundaries.","vars":{"size":3,"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"calc":"top=0, right=2, bottom=2, left=0"},{"line":11,"note":"Cells are left, so start the first lap.","vars":{"top":0,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[]}],"check":{"expr":"left<right && top<bottom → 0<2 && 0<2","result":true},"loop":"lap 1"},{"line":14,"note":"Walk the top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,0]},{"kind":"array","name":"ans","values":[1],"highlight":[0]}],"moves":[{"from":"matrix[0][0]","to":"ans[0]"}],"calc":"push matrix[0][0] = 1","loop":"lap 1 · move right · i = 0"},{"line":14,"note":"Top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,1]},{"kind":"array","name":"ans","values":[1,2],"highlight":[1]}],"moves":[{"from":"matrix[0][1]","to":"ans[1]"}],"calc":"push matrix[0][1] = 2","loop":"lap 1 · move right · i = 1"},{"line":14,"note":"Top row.","vars":{"top":0,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[0,2]},{"kind":"array","name":"ans","values":[1,2,3],"highlight":[2]}],"moves":[{"from":"matrix[0][2]","to":"ans[2]"}],"calc":"push matrix[0][2] = 3","loop":"lap 1 · move right · i = 2"},{"line":16,"note":"Shrink top.","vars":{"top":1,"right":2,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3]}],"calc":"top = 0 + 1 = 1","loop":"lap 1"},{"line":20,"note":"Walk the right column.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,2]},{"kind":"array","name":"ans","values":[1,2,3,6],"highlight":[3]}],"moves":[{"from":"matrix[1][2]","to":"ans[3]"}],"calc":"push matrix[1][2] = 6","loop":"lap 1 · move down · i = 1"},{"line":20,"note":"Right column.","vars":{"top":1,"right":2,"bottom":2,"left":0,"i":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,2]},{"kind":"array","name":"ans","values":[1,2,3,6,9],"highlight":[4]}],"moves":[{"from":"matrix[2][2]","to":"ans[4]"}],"calc":"push matrix[2][2] = 9","loop":"lap 1 · move down · i = 2"},{"line":22,"note":"Shrink right.","vars":{"top":1,"right":1,"bottom":2,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9]}],"calc":"right = 2 - 1 = 1","loop":"lap 1"},{"line":26,"note":"Walk the bottom row.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,1]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8],"highlight":[5]}],"moves":[{"from":"matrix[2][1]","to":"ans[5]"}],"calc":"push matrix[2][1] = 8","loop":"lap 1 · move left · i = 1"},{"line":26,"note":"Bottom row.","vars":{"top":1,"right":1,"bottom":2,"left":0,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[2,0]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7],"highlight":[6]}],"moves":[{"from":"matrix[2][0]","to":"ans[6]"}],"calc":"push matrix[2][0] = 7","loop":"lap 1 · move left · i = 0"},{"line":28,"note":"Shrink bottom.","vars":{"top":1,"right":1,"bottom":1,"left":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7]}],"calc":"bottom = 2 - 1 = 1","loop":"lap 1"},{"line":32,"note":"Walk the left column.","vars":{"top":1,"right":1,"bottom":1,"left":0,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"current":[1,0]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4],"highlight":[7]}],"moves":[{"from":"matrix[1][0]","to":"ans[7]"}],"calc":"push matrix[1][0] = 4","loop":"lap 1 · move up · i = 1"},{"line":34,"note":"Shrink left. Now all four boundaries point at the middle cell (1,1), and 5 is still unvisited.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4]}],"calc":"left = 0 + 1 = 1","loop":"lap 1"},{"line":11,"note":"BUG: the strict < stops the loop, even though one cell (5) is left. When left == right (or top == bottom) there is still a row/column of cells to visit, so the condition needs <=.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4]}],"mistake":true,"check":{"expr":"left<right && top<bottom → 1<1 && 1<1","result":false},"loop":"lap 2?"},{"line":37,"note":"Returns [1,2,3,6,9,8,7,4]. Expected [1,2,3,6,9,8,7,4,5]: 5 is missing.","vars":{"top":1,"right":1,"bottom":1,"left":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6],[7,8,9]],"highlight":[[1,1]]},{"kind":"array","name":"ans","values":[1,2,3,6,9,8,7,4]}]}]}