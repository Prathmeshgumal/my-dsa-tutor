{"id":"86428417-bd08-4326-ae06-d88bb41d4380","title":"Dry run: printExtremeElementsAlternately on 9 elements","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<int> printExtremeElementsAlternately(vector<int>& arr) {\n        sort(arr.begin(),arr.end());\n        int size = arr.size();\n        int start = 0;\n        int end = size-1;\n        vector<int>ans;\n        if(size%2 ==0){\n            while(start<end){\n                ans.push_back(arr[start]);\n                start++;\n                ans.push_back(arr[end]);\n                end--;\n            }\n        }\n        else{\n            while(start<=end){\n                ans.push_back(arr[start]);\n                start++;\n                if(start<=end){\n                    ans.push_back(arr[end]);\n                }\n                end--;\n            }\n        }\n        return ans;\n    }\n};","problem":"print-extreme-elements-alternately","input":"arr = [9,2,7,4,1,8,3,6,5]","expected":"[1,9,2,8,3,7,4,6,5]","createdAt":1792690967512,"steps":[{"line":4,"note":"Sort the array: [9,2,7,4,1,8,3,6,5] becomes [1..9].","vars":{},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","phase":"Setup"},{"line":5,"note":"Store the number of elements.","vars":{"size":9},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","calc":"size = 9"},{"line":7,"note":"start = 0 (smallest), end = 8 (largest).","vars":{"size":9,"start":0,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":0,"end":8}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","calc":"end = 9 - 1 = 8"},{"line":9,"note":"9 is odd, so the else branch runs.","vars":{"size":9,"start":0,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":0,"end":8}},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","check":{"expr":"9 % 2 == 0 → 1 == 0","result":false}},{"line":18,"note":"The pointers haven't crossed.","vars":{"size":9,"start":0,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":0,"end":8},"highlight":[0,8]},{"kind":"array","name":"ans","values":[],"capacity":0}],"output":"","check":{"expr":"start <= end → 0 <= 8","result":true},"loop":"iteration 1","phase":"Iteration 1"},{"line":19,"note":"Push the smallest value, 1.","vars":{"size":9,"start":0,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":0,"end":8},"done":[0]},{"kind":"array","name":"ans","values":[1],"capacity":1}],"output":"","moves":[{"from":"arr[0]","to":"ans[0]","label":"1"}],"loop":"iteration 1"},{"line":20,"note":"Move start right.","vars":{"size":9,"start":1,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":8},"done":[0]},{"kind":"array","name":"ans","values":[1],"capacity":1}],"output":"","calc":"start = 0 + 1 = 1","loop":"iteration 1"},{"line":21,"note":"end is a different, unused element, so it is safe to push.","vars":{"size":9,"start":1,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":8},"done":[0]},{"kind":"array","name":"ans","values":[1],"capacity":1}],"output":"","check":{"expr":"start <= end → 1 <= 8","result":true},"loop":"iteration 1"},{"line":22,"note":"Push the largest value, 9.","vars":{"size":9,"start":1,"end":8},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":8},"done":[0,8]},{"kind":"array","name":"ans","values":[1,9],"capacity":2}],"output":"","moves":[{"from":"arr[8]","to":"ans[1]","label":"9"}],"loop":"iteration 1"},{"line":24,"note":"Move end left.","vars":{"size":9,"start":1,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":7},"done":[0,8]},{"kind":"array","name":"ans","values":[1,9],"capacity":2}],"output":"","calc":"end = 8 - 1 = 7","loop":"iteration 1"},{"line":18,"note":"The loop continues.","vars":{"size":9,"start":1,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":7},"highlight":[1,7],"done":[0,8]},{"kind":"array","name":"ans","values":[1,9],"capacity":2}],"output":"","check":{"expr":"start <= end → 1 <= 7","result":true},"loop":"iteration 2","phase":"Iteration 2"},{"line":19,"note":"Push the next smallest value, 2. The vector is full, so its capacity grows from 2 to 4.","vars":{"size":9,"start":1,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":1,"end":7},"done":[0,1,8]},{"kind":"array","name":"ans","values":[1,9,2],"capacity":4}],"output":"","moves":[{"from":"arr[1]","to":"ans[2]","label":"2"}],"loop":"iteration 2"},{"line":20,"note":"Move start right.","vars":{"size":9,"start":2,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":7},"done":[0,1,8]},{"kind":"array","name":"ans","values":[1,9,2],"capacity":4}],"output":"","calc":"start = 1 + 1 = 2","loop":"iteration 2"},{"line":21,"note":"It is safe to push end.","vars":{"size":9,"start":2,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":7},"done":[0,1,8]},{"kind":"array","name":"ans","values":[1,9,2],"capacity":4}],"output":"","check":{"expr":"start <= end → 2 <= 7","result":true},"loop":"iteration 2"},{"line":22,"note":"Push the next largest value, 8.","vars":{"size":9,"start":2,"end":7},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":7},"done":[0,1,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8],"capacity":4}],"output":"","moves":[{"from":"arr[7]","to":"ans[3]","label":"8"}],"loop":"iteration 2"},{"line":24,"note":"Move end left.","vars":{"size":9,"start":2,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":6},"done":[0,1,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8],"capacity":4}],"output":"","calc":"end = 7 - 1 = 6","loop":"iteration 2"},{"line":18,"note":"The loop continues.","vars":{"size":9,"start":2,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":6},"highlight":[2,6],"done":[0,1,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8],"capacity":4}],"output":"","check":{"expr":"start <= end → 2 <= 6","result":true},"loop":"iteration 3","phase":"Iteration 3"},{"line":19,"note":"Push 3. Capacity grows from 4 to 8.","vars":{"size":9,"start":2,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":2,"end":6},"done":[0,1,2,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3],"capacity":8}],"output":"","moves":[{"from":"arr[2]","to":"ans[4]","label":"3"}],"loop":"iteration 3"},{"line":20,"note":"Move start right.","vars":{"size":9,"start":3,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":6},"done":[0,1,2,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3],"capacity":8}],"output":"","calc":"start = 2 + 1 = 3","loop":"iteration 3"},{"line":21,"note":"It is safe to push end.","vars":{"size":9,"start":3,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":6},"done":[0,1,2,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3],"capacity":8}],"output":"","check":{"expr":"start <= end → 3 <= 6","result":true},"loop":"iteration 3"},{"line":22,"note":"Push 7.","vars":{"size":9,"start":3,"end":6},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":6},"done":[0,1,2,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7],"capacity":8}],"output":"","moves":[{"from":"arr[6]","to":"ans[5]","label":"7"}],"loop":"iteration 3"},{"line":24,"note":"Move end left.","vars":{"size":9,"start":3,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":5},"done":[0,1,2,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7],"capacity":8}],"output":"","calc":"end = 6 - 1 = 5","loop":"iteration 3"},{"line":18,"note":"The loop continues.","vars":{"size":9,"start":3,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":5},"highlight":[3,5],"done":[0,1,2,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7],"capacity":8}],"output":"","check":{"expr":"start <= end → 3 <= 5","result":true},"loop":"iteration 4","phase":"Iteration 4"},{"line":19,"note":"Push 4.","vars":{"size":9,"start":3,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":3,"end":5},"done":[0,1,2,3,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4],"capacity":8}],"output":"","moves":[{"from":"arr[3]","to":"ans[6]","label":"4"}],"loop":"iteration 4"},{"line":20,"note":"Move start right.","vars":{"size":9,"start":4,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":5},"done":[0,1,2,3,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4],"capacity":8}],"output":"","calc":"start = 3 + 1 = 4","loop":"iteration 4"},{"line":21,"note":"It is safe to push end.","vars":{"size":9,"start":4,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":5},"done":[0,1,2,3,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4],"capacity":8}],"output":"","check":{"expr":"start <= end → 4 <= 5","result":true},"loop":"iteration 4"},{"line":22,"note":"Push 6.","vars":{"size":9,"start":4,"end":5},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":5},"done":[0,1,2,3,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6],"capacity":8}],"output":"","moves":[{"from":"arr[5]","to":"ans[7]","label":"6"}],"loop":"iteration 4"},{"line":24,"note":"Move end left. start and end now both point at the middle element 5.","vars":{"size":9,"start":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":4},"done":[0,1,2,3,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6],"capacity":8}],"output":"","calc":"end = 5 - 1 = 4","loop":"iteration 4"},{"line":18,"note":"start == end, so the loop runs one more time for the middle element.","vars":{"size":9,"start":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":4},"highlight":[4],"done":[0,1,2,3,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6],"capacity":8}],"output":"","check":{"expr":"start <= end → 4 <= 4","result":true},"loop":"iteration 5","phase":"Middle element"},{"line":19,"note":"Push the middle value, 5. Capacity grows from 8 to 16.","vars":{"size":9,"start":4,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":4,"end":4},"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"","moves":[{"from":"arr[4]","to":"ans[8]","label":"5"}],"loop":"iteration 5"},{"line":20,"note":"Move start right. It is now past end.","vars":{"size":9,"start":5,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":5,"end":4},"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"","calc":"start = 4 + 1 = 5","loop":"iteration 5"},{"line":21,"note":"This is your fix working: end points at 5, which was just pushed, so the check is false and the second push is skipped. No duplicate is added.","vars":{"size":9,"start":5,"end":4},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":5,"end":4},"highlight":[4],"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"","check":{"expr":"start <= end → 5 <= 4","result":false},"loop":"iteration 5"},{"line":24,"note":"Move end left.","vars":{"size":9,"start":5,"end":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":5,"end":3},"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"","calc":"end = 4 - 1 = 3","loop":"iteration 5"},{"line":18,"note":"The pointers have crossed, so the loop ends.","vars":{"size":9,"start":5,"end":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":5,"end":3},"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"","check":{"expr":"start <= end → 5 <= 3","result":false},"phase":"Return"},{"line":27,"note":"Return ans. It has all 9 elements, each used exactly once.","vars":{"size":9,"start":5,"end":3},"structures":[{"kind":"array","name":"arr","values":[1,2,3,4,5,6,7,8,9],"pointers":{"start":5,"end":3},"done":[0,1,2,3,4,5,6,7,8]},{"kind":"array","name":"ans","values":[1,9,2,8,3,7,4,6,5],"capacity":16}],"output":"[1,9,2,8,3,7,4,6,5]"}]}