{"id":"eeca9ff1-99a4-4b13-a6bf-b9efcf8d105f","title":"Dry run (fixed): transpose on [[1,2,3],[4,5,6]]","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    vector<vector<int>> transpose(vector<vector<int>>& matrix) {\n        int rows = matrix.size();\n        int col = matrix[0].size();\n        vector<vector<int>>result(col,vector<int>(rows));\n\n        for(int i=0;i<rows;i++){\n            for(int j=0;j<col;j++){\n                result[j][i] = matrix[i][j];\n            }\n        }\n\n        return result;\n    }\n};","problem":"transpose-matrix","input":"matrix = [[1,2,3],[4,5,6]]","createdAt":1792603901424,"steps":[{"line":4,"note":"Count the rows of the input.","vars":{"rows":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]}],"calc":"rows = matrix.size() = 2"},{"line":5,"note":"Count the columns of the input.","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]}],"calc":"col = matrix[0].size() = 3"},{"line":6,"note":"result is col × rows = 3 × 2, the shape of the transpose.","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0],[0,0],[0,0]]}],"calc":"result = 3 rows × 2 cols of 0"},{"line":8,"note":"Outer loop starts on input row 0.","vars":{"rows":2,"col":3,"i":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0],[0,0],[0,0]]}],"check":{"expr":"i < rows → 0 < 2","result":true},"loop":"i = 0"},{"line":9,"note":"Inner loop starts.","vars":{"rows":2,"col":3,"i":0,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[0,0],[0,0],[0,0]]}],"check":{"expr":"j < col → 0 < 3","result":true},"loop":"i = 0 · j = 0"},{"line":10,"note":"Assignment now: matrix[0][0] = 1 goes to result[0][0].","vars":{"rows":2,"col":3,"i":0,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,0]]},{"kind":"grid","name":"result","rows":[[1,0],[0,0],[0,0]],"current":[0,0]}],"calc":"result[0][0] = matrix[0][0] = 1","loop":"i = 0 · j = 0"},{"line":10,"note":"Row 0 of the input becomes column 0 of result: 2 goes to result[1][0].","vars":{"rows":2,"col":3,"i":0,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,1]]},{"kind":"grid","name":"result","rows":[[1,0],[2,0],[0,0]],"current":[1,0]}],"calc":"result[1][0] = matrix[0][1] = 2","loop":"i = 0 · j = 1"},{"line":10,"note":"3 goes to result[2][0]. Column 0 of result is done.","vars":{"rows":2,"col":3,"i":0,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[0,2]]},{"kind":"grid","name":"result","rows":[[1,0],[2,0],[3,0]],"current":[2,0]}],"calc":"result[2][0] = matrix[0][2] = 3","loop":"i = 0 · j = 2"},{"line":8,"note":"Next input row.","vars":{"rows":2,"col":3,"i":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[1,0],[2,0],[3,0]]}],"check":{"expr":"i < rows → 1 < 2","result":true},"loop":"i = 1"},{"line":10,"note":"4 goes to result[0][1].","vars":{"rows":2,"col":3,"i":1,"j":0},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[1,0]]},{"kind":"grid","name":"result","rows":[[1,4],[2,0],[3,0]],"current":[0,1]}],"calc":"result[0][1] = matrix[1][0] = 4","loop":"i = 1 · j = 0"},{"line":10,"note":"5 goes to result[1][1].","vars":{"rows":2,"col":3,"i":1,"j":1},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[1,1]]},{"kind":"grid","name":"result","rows":[[1,4],[2,5],[3,0]],"current":[1,1]}],"calc":"result[1][1] = matrix[1][1] = 5","loop":"i = 1 · j = 1"},{"line":10,"note":"6 goes to result[2][1]. Every cell is filled.","vars":{"rows":2,"col":3,"i":1,"j":2},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]],"highlight":[[1,2]]},{"kind":"grid","name":"result","rows":[[1,4],[2,5],[3,6]],"current":[2,1]}],"calc":"result[2][1] = matrix[1][2] = 6","loop":"i = 1 · j = 2"},{"line":14,"note":"The loops end and the function returns [[1,4],[2,5],[3,6]], which matches the expected output.","vars":{"rows":2,"col":3},"structures":[{"kind":"grid","name":"matrix","rows":[[1,2,3],[4,5,6]]},{"kind":"grid","name":"result","rows":[[1,4],[2,5],[3,6]]}],"output":"[[1,4],[2,5],[3,6]]","check":{"expr":"i < rows → 2 < 2","result":false}}]}