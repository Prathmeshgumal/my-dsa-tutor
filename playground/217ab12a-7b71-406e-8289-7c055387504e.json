{"id":"217ab12a-7b71-406e-8289-7c055387504e","title":"Dry run: rotate on [1,2,3,4,5,6,7], k = 2 (case 9)","file":"solution.cpp","language":"cpp","code":"class Solution {\npublic:\n    void rotate(vector<int>& nums, int k) {\n        int size = nums.size();\n        int shift = k%size;\n\n        vector<int> temp;\n        for(int i=size-shift;i<=size;i++){\n            temp.push_back(nums[i]);\n        }\n\n        for(int j=size-1;j>=size-1-shift;j--){\n            nums[j] = nums[j-shift];\n        }\n\n        for(int k=0;k<shift;k++){\n            nums[k] = temp[k];\n        }\n    }\n};","problem":"rotate-an-array","input":"nums = [1,2,3,4,5,6,7], k = 2","createdAt":1792513017180,"steps":[{"line":4,"note":"Store the array's length.","vars":{"k":2,"size":7},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"size = 7"},{"line":5,"note":"Each element moves 2 places right.","vars":{"k":2,"size":7,"shift":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]}],"calc":"shift = 2 % 7 = 2"},{"line":7,"note":"Empty temp.","vars":{"size":7,"shift":2},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]},{"kind":"array","name":"temp","values":[],"capacity":0}]},{"line":9,"note":"i starts at size-shift = 5, which is the correct start. Save nums[5] = 6.","vars":{"size":7,"shift":2,"i":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":5},"highlight":[5]},{"kind":"array","name":"temp","values":[6],"capacity":1}],"moves":[{"from":"nums[5]","to":"temp[0]"}],"check":{"expr":"5 <= 7","result":true},"calc":"i = 7 - 2 = 5","loop":"save loop · i = 5"},{"line":9,"note":"i = 6: save nums[6] = 7. temp = [6, 7] is now complete and in the right order.","vars":{"size":7,"shift":2,"i":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":6},"highlight":[6]},{"kind":"array","name":"temp","values":[6,7],"capacity":2}],"moves":[{"from":"nums[6]","to":"temp[1]"}],"check":{"expr":"6 <= 7","result":true},"loop":"save loop · i = 6"},{"line":9,"note":"i = 7: 7 <= 7 is still true, so it reads nums[7], which is past the end (undefined behaviour). The garbage value '?' is never used later, so the output isn't affected, but it can crash. Use i < size.","vars":{"size":7,"shift":2,"i":7},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"i":7}},{"kind":"array","name":"temp","values":[6,7,"?"],"highlight":[2],"capacity":4}],"mistake":true,"check":{"expr":"7 <= 7","result":true},"calc":"temp.push_back(nums[7]) → garbage","loop":"save loop · i = 7"},{"line":8,"note":"i = 8: the loop ends.","vars":{"size":7,"shift":2,"i":8},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"check":{"expr":"8 <= 7","result":false},"loop":"save loop · i = 8"},{"line":12,"note":"Shift loop runs while j >= size-1-shift = 4. Here that is NOT equal to shift (2). Five elements (1..5) need to move, but this range covers only 3 of them.","vars":{"size":7,"shift":2,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,7],"pointers":{"j":6}},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"check":{"expr":"6 >= 4","result":true},"loop":"shift loop · j = 6"},{"line":13,"note":"nums[6] = nums[4] = 5.","vars":{"size":7,"shift":2,"j":6},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,6,5],"pointers":{"j":6},"highlight":[4]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"moves":[{"from":"nums[4]","to":"nums[6]"}],"calc":"nums[6] = nums[6-2] = 5","loop":"shift loop · j = 6"},{"line":13,"note":"j = 5: nums[5] = nums[3] = 4.","vars":{"size":7,"shift":2,"j":5},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,5,4,5],"pointers":{"j":5},"highlight":[3]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"moves":[{"from":"nums[3]","to":"nums[5]"}],"check":{"expr":"5 >= 4","result":true},"calc":"nums[5] = nums[5-2] = 4","loop":"shift loop · j = 5"},{"line":13,"note":"j = 4: nums[4] = nums[2] = 3.","vars":{"size":7,"shift":2,"j":4},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,3,4,5],"pointers":{"j":4},"highlight":[2]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"moves":[{"from":"nums[2]","to":"nums[4]"}],"check":{"expr":"4 >= 4","result":true},"calc":"nums[4] = nums[4-2] = 3","loop":"shift loop · j = 4"},{"line":12,"note":"j = 3: 3 >= 4 is false, so the loop stops. j = 3 (nums[3] = nums[1] = 2) and j = 2 (nums[2] = nums[0] = 1) never run, so 1 and 2 are lost. The condition should be j >= shift.","vars":{"size":7,"shift":2,"j":3},"structures":[{"kind":"array","name":"nums","values":[1,2,3,4,3,4,5],"pointers":{"j":3},"highlight":[0,1]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}],"mistake":true,"check":{"expr":"3 >= 4","result":false},"loop":"shift loop · j = 3"},{"line":17,"note":"Copy-back, k = 0: nums[0] = temp[0] = 6. Correct.","vars":{"size":7,"shift":2,"k":0},"structures":[{"kind":"array","name":"nums","values":[6,2,3,4,3,4,5],"pointers":{"k":0}},{"kind":"array","name":"temp","values":[6,7,"?"],"highlight":[0],"capacity":4}],"moves":[{"from":"temp[0]","to":"nums[0]"}],"check":{"expr":"0 < 2","result":true},"loop":"copy loop · k = 0"},{"line":17,"note":"k = 1: nums[1] = temp[1] = 7. Correct. Then k = 2 fails 2 < 2.","vars":{"size":7,"shift":2,"k":1},"structures":[{"kind":"array","name":"nums","values":[6,7,3,4,3,4,5],"pointers":{"k":1},"done":[0,1,4,5,6]},{"kind":"array","name":"temp","values":[6,7,"?"],"highlight":[1],"capacity":4}],"moves":[{"from":"temp[1]","to":"nums[1]"}],"check":{"expr":"1 < 2","result":true},"loop":"copy loop · k = 1"},{"line":19,"note":"Result [6,7,3,4,3,4,5], expected [6,7,1,2,3,4,5]. Indices 2 and 3 were never written by the shift loop.","vars":{"size":7,"shift":2},"structures":[{"kind":"array","name":"nums","values":[6,7,3,4,3,4,5],"done":[0,1,4,5,6]},{"kind":"array","name":"temp","values":[6,7,"?"],"capacity":4}]}]}